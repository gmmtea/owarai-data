---
import Base from "../../layouts/Base.astro";
import { listEditionParams, getCompetitionYearTables, listEditionYears } from "../../lib/queries";
import FinalResultsTable from "../../components/FinalResultsTable.astro";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  // editionsに存在する大会キーだけに限定（空大会でビルドが落ちないように）
  const params = listEditionParams(); // [{comp, year}, ...]
  const comps = Array.from(new Set(params.map(p => p.comp)));
  return comps.map((comp) => ({ params: { comp } }));
}

const { comp } = Astro.params as { comp: string };
const list = getCompetitionYearTables(comp); // { year|null, short_label|null, table|null }[]
if (!list.length) throw new Error("該当データなし");
const compName = list.find(x=>x.table)?.table?.edition.competition_name ?? "大会";

const pickFinalRows = (table: any) =>
  (table?.rows ?? []).filter((r: any) => Number(r.rank_sort) <= 40);
const yearsAsc = listEditionYears(comp);      // 昇順
const years = [...yearsAsc].sort((a,b)=>b-a); // 降順に並べ替え
---
<Base title={`${compName} 歴代結果一覧`}>
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <span>{compName}</span>
  </nav>

  <h1>{compName} 歴代結果一覧</h1>

  {years.length > 0 && (
    <nav class="year-toc" aria-label="年目次">
      {years.map((y, i) => (
        <>
          {i > 0 && <span class="sep"> / </span>}
          <a href={`#y-${y}`}>{y}</a>
        </>
      ))}
    </nav>
  )}

  {list.map(({ year, short_label, table }) => {
    const label = short_label ?? (year != null ? `${year}` : "（回次未設定）");
    const cols = table ? table.columns : [];
    const rows = table ? pickFinalRows(table) : [];
    return (
      <section>
        <h2 class="kv" id={year != null ? `y-${year}` : undefined}>
          {table ? (<a href={`${base}${comp}/${table.edition.year}`}>{label}</a>) : label}
        </h2>

        {rows.length > 0 && (
          <>
            {table ? (
              <FinalResultsTable base={base} cols={cols} rows={rows} />
            ) : (
              <p class="muted">この回はページ未対応（year 未設定）。</p>
            )}
          </>
        )}
      </section>
    );
  })}

  <style>
    :root { --sticky-header: 75px; }

    /* アンカー付き見出しがスクロール停止するときの余白 */
    h2[id] { scroll-margin-top: calc(var(--sticky-header) + 8px); }
  </style>
</Base>
