---
import Base from "../../layouts/Base.astro";
import { listEditionParams, getEditionTable, getJudgeScoreTable, listEditionYears } from "../../lib/queries";
import JudgeScoresTable from "../../components/JudgeScoresTable.astro";
import FinalResultsTable from "../../components/FinalResultsTable.astro";

type ResultColumnRole =
  | "default"
  | "firstOrder"
  | "withVideo";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
};

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const params = listEditionParams()
    .filter(p => p.year != null)
    .map(p => ({ params: { comp: p.comp, year: String(p.year) } }));

  return params;
}

const { comp, year } = Astro.params as { comp: string; year: string };
const y = Number(year);
const data = getEditionTable(comp, y);
if (!data) throw new Error("該当データなし");
const { edition, rows, columns } = data;

// ラベルを受け取る
const semifinalLabel   = edition.semifinal_label   ?? "準決勝進出組";
const quarterfinalLabel = edition.quarterfinal_label ?? "準々決勝進出組";

// ページタイトル
const pageTitle = edition.title ?? `${edition.competition_name} ${edition.year} 結果`;

// "YYYY-MM-DD" → "YYYY年M月D日(曜)" 変換（final_date があれば表示）
function formatJpDate(s?: string | null) {
  if (!s) return null;
  // "YYYY-M-D" or "YYYY-MM-DD" を許容して手動パース
  const m = String(s).trim().match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (!m) return s; // 期待フォーマットでない場合は原文返し
  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
  // UTC基準で曜日を出す（ローカルTZのズレ防止）
  const dt = new Date(Date.UTC(y, mo - 1, d));
  const youbi = ["日","月","火","水","木","金","土"][dt.getUTCDay()];
  return `${y}年${mo}月${d}日(${youbi})`;
}

const finalDateText = formatJpDate(edition.final_date);

const round1 = getJudgeScoreTable(comp, y, 1);
const round2 = getJudgeScoreTable(comp, y, 2);
const round3 = getJudgeScoreTable(comp, y, 3);

// 投票/得点モード
const mode1 = round1?.mode ?? "score";
const mode2 = round2?.mode ?? "score";
const mode3 = round3?.mode ?? "score";

// スコア方式のラウンドだけ抽出
const s1 = (round1 && round1.mode === "score") ? round1 : null;
const s2 = (round2 && round2.mode === "score") ? round2 : null;
const s3 = (round3 && round3.mode === "score") ? round3 : null;

// 決勝表に載せる行（rank_sort <= 40 のみ）
const finalRows = rows.filter((r: any) => Number(r.rank_sort ?? 99999) <= 40);

// 準決勝進出者一覧（rank_sort === 50、名前順）
const semifinals = rows.filter((r: any) =>
  r.rank_sort === 50
).sort((a: any, b: any) => {
  const ar = a.reading ?? a.name;
  const br = b.reading ?? b.name;
  return String(ar).localeCompare(String(br), "ja");
});

// 準々決勝進出者一覧（rank_sort === 100、名前順）
const quarterfinals = rows.filter((r: any) =>
  r.rank_sort === 100
).sort((a: any, b: any) => {
  const ar = a.reading ?? a.name;
  const br = b.reading ?? b.name;
  return String(ar).localeCompare(String(br), "ja");
});

/** 両ラウンド合算で各席の min/max→mid/half を作り、最大 half を globalHalf に */
function buildSharedScale(r1: typeof round1, r2: typeof round2, r3: typeof round3){
  const bySeat: Record<number, { mid:number; half:number }> = {};
  let globalHalf = 0;

  // 座席リスト（通常は同じだが、念のためユニオン）
  const seatNos = new Set<number>();
  for (const s of (r1?.seats ?? [])) seatNos.add(s.seat_no);
  for (const s of (r2?.seats ?? [])) seatNos.add(s.seat_no);
  for (const s of (r3?.seats ?? [])) seatNos.add(s.seat_no);

  for (const seat of seatNos) {
    let min = +Infinity, max = -Infinity;
    for (const tbl of [r1, r2, r3]) {
      if (!tbl) continue;
      for (const row of tbl.rows) {
        const v = row.bySeat[seat];
        if (typeof v === "number" && !Number.isNaN(v)) {
          if (v < min) min = v;
          if (v > max) max = v;
        }
      }
    }
    if (min === +Infinity) { min = 0; max = 0; }
    const mid  = (min + max) / 2;
    const half = Math.max(0, (max - min) / 2);
    bySeat[seat] = { mid, half };
    if (half > globalHalf) globalHalf = half;
  }
  if (globalHalf === 0) globalHalf = 1;

  // 合計列のスケール（両ラウンド合算）
  let tmin = +Infinity, tmax = -Infinity;
  for (const tbl of [r1, r2, r3]) {
    if (!tbl) continue;
    for (const row of tbl.rows) {
      const v = row.total;
      if (typeof v === "number" && !Number.isNaN(v)) {
        if (v < tmin) tmin = v;
        if (v > tmax) tmax = v;
      }
    }
  }
  const total = (tmin===+Infinity)
    ? { mid: 0, half: 1 }
    : { mid: (tmin + tmax)/2, half: Math.max(1e-9, (tmax - tmin)/2) };
  return { bySeat, globalHalf, total };
}

const sharedScale = buildSharedScale(s1, s2, s3);

// 前年・翌年を特定
const years = listEditionYears(comp);                // 昇順
const i = years.indexOf(y);
const prevYear = i > 0 ? years[i-1] : null;          // 前年（存在すれば）
const nextYear = i >= 0 && i < years.length-1 ? years[i+1] : null; // 翌年

// 列 enrichment
function enrichColumns(rawCols: any[]): Column[] {
  return rawCols.map((c: any) => {
    let role: ResultColumnRole | undefined;

    if (c.key === "first_order") {
      role = "firstOrder";
    } else if (c.related_key) {
      role = "withVideo";
    }

    return { ...c, role };
  });
}

const cols: Column[] = enrichColumns(columns);
---
<Base title={`${pageTitle} 結果`}>
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <a href={`${base}${comp}`}>{edition.competition_name}</a><span class="sep">/</span>
    <span>{edition.year}年</span>
  </nav>

  <div class="sticky-h1">
    <div class="h1-row">
      <h1>{pageTitle} 結果</h1>
      {(prevYear != null || nextYear != null) && (
        <nav class="year-pager">
          {prevYear != null && (
            <a class="btn" href={`${base}${comp}/${prevYear}`} aria-label={`${prevYear}年へ`}>← {prevYear}</a>
          )}
          {nextYear != null && (
            <a class="btn" href={`${base}${comp}/${nextYear}`} aria-label={`${nextYear}年へ`}>{nextYear} →</a>
          )}
        </nav>
      )}
    </div>
  </div>

  {finalRows.length > 0 && (
    <FinalResultsTable base={base} cols={cols} rows={finalRows} />
  )}

  {/** 1本目：ブロック分割があるならブロック→試合ごとに見出しを分けて表示 */}
  {round1 && (() => {
    const baseTitle = `1本目 ${mode1 === "vote" ? "得票" : "得点"}詳細`;

    // groups が存在する場合
    if (round1.groups && round1.groups.length > 0) {
      return (
        <section>
          {/* 1本目全体の大見出し */}
          <h2>{baseTitle}</h2>

          {round1.groups.map((g: any) => {
            const rows: any[] = g.rows ?? [];

            const hasAnyMatchNo = rows.some((r) => r.match_no != null);
            const allHaveMatchNo = hasAnyMatchNo && rows.every((r) => r.match_no != null);

            // --- ① 試合番号が揃っていないブロック → ブロック1表だけ（h3 + テーブル） ---
            if (!allHaveMatchNo) {
              return (
                <section>
                  <h3>{`${g.label}ブロック`}</h3>
                  <JudgeScoresTable
                    base={base}
                    table={{ seats: round1.seats, rows }}
                    mode={mode1}
                    {...(mode1 === "score" ? { scale: sharedScale } : {})}
                  />
                </section>
              );
            }

            // --- ② 試合番号が揃っているブロック → 試合ごとに h4 + テーブル ---
            const buckets: { [matchNo: number]: any[] } = {};

            for (const r of rows) {
              const m = Number(r.match_no);
              if (!Number.isFinite(m)) continue;
              if (!buckets[m]) {
                buckets[m] = [];
              }
              buckets[m].push(r);
            }

            const matchNos = Object.keys(buckets)
              .map((s) => Number(s))
              .sort((a, b) => a - b);

            return (
              <section>
                {/* ブロック名を中くらいの見出しに */}
                <h3>{`${g.label}ブロック`}</h3>

                {matchNos.map((mno) => (
                  <section>
                    {/* 試合番号を小さい見出しに */}
                    <h4>{`第${mno}試合`}</h4>
                    <JudgeScoresTable
                      base={base}
                      table={{ seats: round1.seats, rows: buckets[mno] }}
                      mode={mode1}
                      {...(mode1 === "score" ? { scale: sharedScale } : {})}
                    />
                  </section>
                ))}
              </section>
            );
          })}
        </section>
      );
    }

    // groups が無いケース：これまで通り 1テーブルのみ（h2 + テーブル）
    return (
      <section>
        <h2>{baseTitle}</h2>
        <JudgeScoresTable
          base={base}
          table={round1}
          mode={mode1}
          {...(mode1 === "score" ? { scale: sharedScale } : {})}
        />
      </section>
    );
  })()}

  {round2 && round2.rows && round2.rows.length > 0 && (
    <section>
      <h2>{`2本目 ${mode2 === "vote" ? "得票" : "得点"}詳細`}</h2>
      <JudgeScoresTable
        base={base}
        table={round2}
        mode={mode2}
        {...(mode2 === "score" ? { scale: sharedScale } : {})}
      />
    </section>
  )}

  {/** 3本目：通常通り（見出しはここで出す） */}
  {round3 && round3.rows && round3.rows.length > 0 && (
    <section>
      <h2>{`3本目 ${mode3 === "vote" ? "得票" : "得点"}詳細`}</h2>
      <JudgeScoresTable
        base={base}
        table={round3}
        mode={mode3}
        {...(mode3 === "score" ? { scale: sharedScale } : {})}
      />
    </section>
  )}

  {/* 準決勝進出者一覧 */}
  {semifinals.length > 0 && (() => {
    const norm = (s:string|undefined|null) => (s ?? "").trim();
    const rows = semifinals.map((r:any) => ({ ...r, cf: norm(r.catchphrase as any) }));
    const a = rows.filter(r => r.cf === "");
    const b = rows.filter(r => r.cf !== "" && !r.cf.includes("ワイルドカード"));
    const c = rows.filter(r => r.cf !== "" && r.cf.includes("ワイルドカード"));
    const ordered = [...a, ...b, ...c];
    return (
      <section>
        <h2>{semifinalLabel}</h2>
          <p class="sf-inline">
            {ordered.map((r:any, i:number) => (
              <>
                <span class="sf-chunk">
                  <a class="muted-link" href={`${base}co/${r.link_id}`}>{r.name}</a>
                  {r.cf && <span class="sf-note muted"> {r.cf}</span>}
                  {i < ordered.length - 1 && " /"}
                </span>
                {i < ordered.length - 1 && " "}
              </>
            ))}
          </p>
      </section>
    );
  })()}

  {/* 準々決勝進出者一覧 */}
  {quarterfinals.length > 0 && (() => {
    const norm = (s:string|undefined|null) => (s ?? "").trim();
    const rows = quarterfinals.map((r:any) => ({ ...r, cf: norm(r.catchphrase as any) }));
    const a = rows.filter(r => r.cf === "");
    const b = rows.filter(r => r.cf !== "" && !r.cf.includes("ワイルドカード"));
    const c = rows.filter(r => r.cf !== "" && r.cf.includes("ワイルドカード"));
    const ordered = [...a, ...b, ...c];
    return (
      <section>
        <h2>{quarterfinalLabel}</h2>
          <p class="sf-inline">
            {ordered.map((r:any, i:number) => (
              <>
                <span class="sf-chunk">
                  <a class="muted-link" href={`${base}co/${r.link_id}`}>{r.name}</a>
                  {r.cf && <span class="sf-note muted"> {r.cf}</span>}
                  {i < ordered.length - 1 && " /"}
                </span>
                {i < ordered.length - 1 && " "}
              </>
            ))}
          </p>
      </section>
    );
  })()}

  <hr class="breath-hr" aria-hidden="true" />
  <p class="muted"><a href={`${base}${comp}`}>← {edition.competition_name} 年別一覧</a> / <a href={base}>トップ</a></p>
</Base>

<style is:inline>
  /* [comp]/[year] 用：h1 をヘッダーの下に固定 */
  .sticky-h1{
    position: sticky;
    top: calc(var(--header-h) + var(--header-gap)); /* 固定ヘッダー分ずらす */
    z-index: 10;          /* テーブル見出し(th: z-index:1)より上に */
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
    /* iOS Safari 対策（ほぼ不要だが保険） */
    position: -webkit-sticky;
  }

  /* もし h1 が大きすぎて詰まるなら微調整可 */
  .sticky-h1 h1{
    margin: 0;            /* 余白で跳ねないように */
    line-height: 1.3;
  }

  .h1-row{ display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; }
  .h1-sub{ margin:0; font-size:14px; }

  /* 準決勝進出のインライン表記 */
  .sf-inline .sf-chunk {
    white-space: nowrap;
  }

  .sf-inline {
    margin: 16px 0 0;
    line-height: 1.9;
    word-break: normal;
    white-space: normal;
  }

  .sf-note {
    white-space: nowrap;
  }

  .breath-hr{
    margin: calc(var(--header-gap) * 2) 0;
    border: 0;
    border-top: 1px solid var(--border);
  }
</style>
