---
import Base from "../layouts/Base.astro";
import { listEditionParams, listCompetitions, listLatestUpdates, listTodaysBirthdayComedians, getEditionWinners } from "../lib/queries";

const base = import.meta.env.BASE_URL;

const params = listEditionParams();  // {comp, year|null, short_label|null}[]

// 大会ラベルと並び順は listCompetitions() から組み立てる
const comps = listCompetitions(); // [{key,name,sort_order}]
const labelByKey = Object.fromEntries(comps.map(c => [c.key, c.name]));
const orderByKey = Object.fromEntries(comps.map(c => [c.key, c.sort_order])); // number|null

// comp → [ {year, short_label}... ] にまとめる
const groups = new Map<string, {year:number|null; short_label:string|null}[]>();
for (const { comp, year, short_label } of params) {
  if (!groups.has(comp)) groups.set(comp, []);
  groups.get(comp)!.push({ year: (year ?? null), short_label: (short_label ?? null) });
}

// 表示カードの配列（優先度付き）
const cards = Array.from(groups.entries()).map(([comp, list]) => {
  // 年降順（NULLは最後）
  list.sort((a,b) =>
    a.year == null ? (b.year == null ? 0 : 1)
    : (b.year == null ? -1 : b.year - a.year)
  );
  const sortOrder = orderByKey[comp];
  // sort_order が小さいほど優先、NULLは末尾扱いのため大きな値を与える
  const priority = (sortOrder == null) ? 1e9 : sortOrder;
  return { comp, name: labelByKey[comp], years: list, priority };
});

// 優先度昇順で並べる（小さい=高優先→先に積む）
cards.sort((a,b) => a.priority - b.priority);

const latestUpdates = listLatestUpdates();
const todaysBirthdayComedians = listTodaysBirthdayComedians();

// 今日の日付を取得（日本時間）
const now = new Date();
const today = new Date(now.getTime() + (9 * 60 * 60 * 1000)); // UTC+9時間
const todayMonth = today.getMonth() + 1;
const todayDay = today.getDate();

// 年齢計算関数
function calculateAge(birthDateStr: string): number {
  const normalized = birthDateStr.replace(/年|月|日/g, '/').replace(/\/+/g, '/').replace(/\/$/, '');
  const parts = normalized.split('/').map(p => parseInt(p.trim()));
  
  if (parts.length === 0 || isNaN(parts[0])) return 0;
  
  const year = parts[0];
  const month = parts.length >= 2 && !isNaN(parts[1]) ? parts[1] : 1;
  const day = parts.length >= 3 && !isNaN(parts[2]) ? parts[2] : 1;
  
  const birthDate = new Date(year, month - 1, day);
  let age = today.getFullYear() - birthDate.getFullYear();
  
  // 今年の誕生日がまだ来ていない場合は1歳減らす
  const todayMonthDay = today.getMonth() * 100 + today.getDate();
  const birthMonthDay = birthDate.getMonth() * 100 + birthDate.getDate();
  if (todayMonthDay < birthMonthDay) {
    age--;
  }
  
  return age;
}

// "YYYY-MM-DD" → "YYYY年MM月DD日(曜)"（曜日はUTC基準で算出してTZズレを避ける）
function formatJpDateWithWeek(s?: string | null) {
  if (!s) return "";
  const m = String(s).trim().match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (!m) return String(s);
  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
  const dt = new Date(Date.UTC(y, mo - 1, d));
  const youbi = ["日","月","火","水","木","金","土"][dt.getUTCDay()];
  return `${y}年${mo}月${d}日(${youbi})`;
}
---

<Base title="お笑い主要データまとめ">
  <h1>お笑い主要データまとめ</h1>

  <div class="card intro">
    <p class="muted">
      お笑い芸人やお笑い賞レースの記録を横断して参照できる非公式データ集です。
    </p>

    <section class="scope-details" aria-label="本日誕生日の芸人">
      {todaysBirthdayComedians.length > 0 && (
        <div class="scope-summary updates-head">
          <h2 class="updates-title">本日（{todayMonth}月{todayDay}日）誕生日の芸人</h2>
        </div>
        <p class="birthday-list-inline muted">
          {todaysBirthdayComedians.map((comedian, index) => (
            <>
              {index > 0 && " / "}
              <a href={`${base}co/${comedian.id}`} class="birthday-name-link">{comedian.name}</a><span class="birthday-age">（{calculateAge(comedian.birth_date || '')}歳）</span>
            </>
          ))}
        </p>
      )}
    </section>

    <section class="scope-details updates-snippet" aria-label="最新の更新">
      <div class="scope-summary updates-head">
        <h2 class="updates-title">最新の更新</h2>
        <a class="updates-all" href={`${base}updates/`}>すべて見る</a>
      </div>

      {latestUpdates.length === 0 ? (
        <p class="muted">更新履歴はまだありません。</p>
      ) : (
        <ul class="muted updates-list">
          {latestUpdates.map((u) => (
            <li class="updates-item">
              <span class="updates-date">{formatJpDateWithWeek(u.date)}</span>
              <span class="updates-content">{u.content}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <details class="scope-details">
      <summary class="scope-summary">
        <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8.5 5.5L16 12l-7.5 6.5" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>現状の収録範囲</span>
      </summary>
      <ul class="muted scope-list">
        <li>M-1／THE MANZAI／KOC／R-1／SECOND／THE W／ダブルインパクト／ABC（2012〜）／ツギクル・ハーベスト／30-1／ytv／UNDER5／歌ネタ王／NHK新人（2025） の 決勝順位／キャッチコピー／各出順／各結果</li>
        <li>ラフターナイト／NHK新人 の決勝順位</li>
        <li>KOC 2013〜2025・しずる／NHK新人 2025／ラフターナイト 2025 の決勝ネタ</li>
        <li>M-1／KOC（2015〜）／R-1（2021〜）1本目／ダブルインパクト／ABC（2012〜）／UNDER5／歌ネタ王／NHK新人（2025） の得点・得票詳細</li>
        <li>M-1／THE MANZAI／KOC／R-1／ダブルインパクト の準決勝進出組</li>
        <li>M-1 全大会 の準々決勝進出組とその個人名</li>
        <li>THE SECOND 全大会のベスト16・ベスト32進出組</li>
      </ul>
    </details>
  </div>

  <!-- Masonry の列を作る親 -->
  <div id="masonry" aria-live="polite"></div>

  <!-- ここに"素材"としてカード群を置き、JSで列に再配置する -->
  <div id="cards-src" hidden>
    {cards.map(card => (
      <section class="comp-card" data-comp={card.comp} data-priority={String(card.priority)}>
        <header class="comp-head">
          <h2 class="comp-title">{card.name}</h2>
          <a class="more-link" href={`${base}${card.comp}`}>歴代結果一覧</a>
        </header>

        <ul class="year-list">
          {card.years.map(({year, short_label}) => {
            const label = short_label ?? (year != null ? `${year}` : "（回次未設定）");
            
            // 優勝者を取得
            let winners: string[] = [];
            if (year != null) {
              try {
                winners = getEditionWinners(card.comp, year);
              } catch (error) {
                console.warn(`Failed to get winners for ${card.comp} ${year}:`, error);
                winners = [];
              }
            }
            
            return (
              <li>
                {year != null ? (
                  <a href={`${base}${card.comp}/${year}`}>
                    {label}{winners.length > 0 && (
                      <span class="winner-info">（{winners.map(name => {
                          if (winners.length > 1) {
                            // 複数の優勝者がいる場合は5文字以上で省略
                            if (name.length >= 5) {
                              return name.substring(0, 3) + '…';
                            }
                          } else {
                            // 単独優勝者の場合は10文字以上で省略
                            if (name.length >= 10) {
                              return name.substring(0, 8) + '…';
                            }
                          }
                          return name;
                        }).join('、')}）
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="muted">{label}</span>
                )}
              </li>
            );
          })}
        </ul>

        <button class="toggle" type="button" aria-expanded="false">もっと見る</button>
      </section>
    ))}
  </div>

  <script is:inline>
    // 折りたたみ（各カード内）
    function setupCollapse(card) {
      const list = card.querySelector('.year-list');
      const btn  = card.querySelector('.toggle');
      if (!list || !btn) return;

      const MAX = 8; // 既定
      const items = list.querySelectorAll('li');
      if (items.length <= MAX) {
        btn.style.display = 'none';
        return;
      }
      list.classList.add('collapsed');
      btn.addEventListener('click', () => {
        const collapsed = list.classList.toggle('collapsed');
        btn.setAttribute('aria-expanded', String(!collapsed));
        btn.textContent = collapsed ? 'もっと見る' : '閉じる';
      });
    }

    // メイソンリー：優先度順で「最短列」に積む
    (function(){
      const root = document.getElementById('masonry');
      const src  = document.getElementById('cards-src');
      if (!root || !src) return;

      // 事前に素材カードをNodeとして確保（優先度順＝DOM順）
      const cards = Array.from(src.children);

      function colCountForWidth(w){
        // シンプルな列数ルール（必要なら調整）
        if (w >= 680) return 3;
        if (w >= 440)  return 2;
        return 1;
      }

      function layout(){
        // いったんクリア
        root.innerHTML = '';

        const n = colCountForWidth(root.clientWidth || window.innerWidth);
        const cols = [];
        for (let i=0;i<n;i++){
          const c = document.createElement('div');
          c.className = 'm-col';
          root.appendChild(c);
          cols.push(c);
        }

        // 優先度順に“最短列”へ追加
        for (const card of cards) {
          // 初回のみ内部の折りたたみセットアップ
          if (!card.__collapseReady) {
            setupCollapse(card);
            card.__collapseReady = true;
          }
          let target = cols[0];
          for (const c of cols) {
            if (c.offsetHeight < target.offsetHeight) target = c;
          }
          target.appendChild(card);
        }
      }

      // 初期配置
      layout();

      // リサイズで再配置（デバウンス）
      let tid = null;
      window.addEventListener('resize', () => {
        clearTimeout(tid);
        tid = setTimeout(layout, 120);
      });
    })();
  </script>

  <style>
    /* イントロ */
    .intro { margin-bottom: 16px; }

    /* 親と列 */
    #masonry {
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
      align-items: start;
    }
    #masonry .m-col {
      display: grid;
      gap: 8px;
    }

    /* 列を横並びに */
    #masonry { grid-auto-flow: column; }
    #masonry { grid-auto-columns: 1fr; }
    #masonry .m-col { min-width: 0; }

    .comp-card {
      border: 1px solid var(--border, #ddd);
      border-radius: 12px;
      padding: 12px 12px 8px;
      margin: 0 0 8px;
      background: var(--card-bg, #fff);
      box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }
    .comp-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 8px;
    }
    .comp-title { font-size: 1.05rem; margin: 0; line-height: 1.2; }
    .more-link { font-size: 0.9rem; white-space: nowrap; }

    .year-list {
      list-style: none; padding: 0; margin: 0;
      display: grid; gap: 4px 8px;
    }
    .year-list li { line-height: 1.6; }
    .year-list li a { white-space: nowrap; }

    .year-list.collapsed {
      max-height: 12.5rem;
      overflow: hidden;
      position: relative;
    }
    .year-list.collapsed::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 3rem;
      background: linear-gradient(to bottom, rgba(255,255,255,0), var(--card-bg, #fff));
      pointer-events: none;
    }

    .toggle {
      display: inline-block;
      margin-top: 6px;
      font-size: 0.9rem;
      padding: 4px 10px;
      border: 1px solid var(--border, #ddd);
      border-radius: 999px;
      background: var(--btn-bg, #fff);
      cursor: pointer;
    }
    .toggle:hover { background: #f8f8f8; }

    /* 更新履歴（トップ用） */
    .updates-snippet {
      margin: 12px 0;
    }
    .updates-head {
      justify-content: space-between;
      cursor: default;
    }
    .updates-title { margin: 0; font-size: 1.0rem; }
    .updates-all { font-size: 0.9rem; white-space: nowrap; }
    .updates-list { margin: 10px 0 2px 1.2em; padding: 0; }
    .updates-item {
      display: grid;
      grid-template-columns: 14ch 1fr; /* "YYYY年M月D日(曜)" が収まる程度 */
      column-gap: 30px;
      align-items: start;
    }

    /* 今日の誕生日芸人（1行形式） */
    .birthday-list-inline {
      margin: 10px 0 8px 1.2em;
      line-height: 1.6;
    }
    .birthday-name-link {
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }
    .birthday-name-link:hover {
      text-decoration: underline;
    }
    .birthday-age {
      font-size: 0.85rem;
      color: var(--muted);
    }
    
    .updates-date {
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .updates-content { white-space: pre-line; }

    /* ========== Winner Info: 優勝者表示のスタイル ========== */
    .winner-info {
      font-size: 0.85em;
      font-weight: normal;
    }
  </style>
</Base>
