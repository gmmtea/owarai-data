---
import Base from "../../layouts/Base.astro";
import { listComediansCanonicalOnlyWithRelatedRanksAndBirthDate } from "../../lib/queries";

const base = import.meta.env.BASE_URL;

/* ============================= かなユーティリティ ============================= */
const canon = (s: string) => s.normalize("NFKC").trim().replace(/\s+/g, " ");
const toHiragana = (s: string) => s.replace(/[\u30A1-\u30F6]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0x60));
const isKanaOnly = (s: string) => /^[\p{sc=Hiragana}\p{sc=Katakana}ー・･・\s]+$/u.test(canon(s));
const stripSymbolsForReading = (s: string) =>
  s.replace(/[・･·\u30FB\uFF65]/g, "")         // 中黒類
   .replace(/[\u0020\u00A0\u3000]/g, "")       // 空白
   .replace(/[()\[\]{}「」『』【】〈〉《》]/g, "") // 括弧
   .replace(/[.,，．\/／]/g, "")               // 句読点など
   .replace(/[-_—–―]/g, "");                   // ハイフン類（長音ーは残す）

// 読みの決定（DBのreading優先。無ければ名前がかなのみなら推測）
const decideReading = (name: string, reading: string | null) => {
  if (reading && reading.trim() !== "") return reading;
  if (isKanaOnly(name)) return stripSymbolsForReading(toHiragana(canon(name)));
  return ""; // 推測不能
};

// 先頭かなの基底化（濁点・半濁点を無声化／小書きを正字へ）
const toBaseHead = (ch: string): string => {
  const h = toHiragana(ch);
  const devoiced = h
    .replace(/[が]/g, "か").replace(/[ぎ]/g, "き").replace(/[ぐ]/g, "く").replace(/[げ]/g, "け").replace(/[ご]/g, "こ")
    .replace(/[ざ]/g, "さ").replace(/[じ]/g, "し").replace(/[ず]/g, "す").replace(/[ぜ]/g, "せ").replace(/[ぞ]/g, "そ")
    .replace(/[だ]/g, "た").replace(/[ぢ]/g, "ち").replace(/[づ]/g, "つ").replace(/[で]/g, "て").replace(/[ど]/g, "と")
    .replace(/[ば]/g, "は").replace(/[び]/g, "ひ").replace(/[ぶ]/g, "ふ").replace(/[べ]/g, "へ").replace(/[ぼ]/g, "ほ")
    .replace(/[ぱ]/g, "は").replace(/[ぴ]/g, "ひ").replace(/[ぷ]/g, "ふ").replace(/[ぺ]/g, "へ").replace(/[ぽ]/g, "ほ")
    .replace(/[ゔ]/g, "う");
  const normalized = devoiced
    .replace(/^ゃ/, "や").replace(/^ゅ/, "ゆ").replace(/^ょ/, "よ")
    .replace(/^ぁ/, "あ").replace(/^ぃ/, "い").replace(/^ぅ/, "う").replace(/^ぇ/, "え").replace(/^ぉ/, "お")
    .replace(/^ゎ/, "わ").replace(/^っ/, "つ");
  return normalized[0] ?? "";
};

// 読みの先頭ひらがな1文字を抽出（記号・長音をスキップ）
const headKana = (s: string): string => {
  const t = stripSymbolsForReading(s).replace(/ー+/g, ""); // 長音は先頭判定から除外
  const m = t.match(/[\p{sc=Hiragana}]/u);
  return m ? m[0] : "";
};

/* ============================= 行・サブキー定義 ============================= */
const groups = [
  { key: "あ", set: "あいうえお" },
  { key: "か", set: "かきくけこがぎぐげご" },
  { key: "さ", set: "さしすせそざじずぜぞ" },
  { key: "た", set: "たちつてとだぢづでど" },
  { key: "な", set: "なにぬねの" },
  { key: "は", set: "はひふへほばびぶべぼぱぴぷぺぽ" },
  { key: "ま", set: "まみむめも" },
  { key: "や", set: "やゆよ" },
  { key: "ら", set: "らりるれろ" },
  { key: "わ", set: "わゐゑをん" }, // ん はここへ寄せる
];
const groupIndex = (ch: string) => {
  const h = toHiragana(ch);
  for (let i = 0; i < groups.length; i++) {
    if (groups[i].set.includes(h)) return i;
  }
  return -1; // その他
};

// 行ごとのサブキー（見出し用）
const rowSubs: Record<string, string[]> = {
  あ: ["あ", "い", "う", "え", "お"],
  か: ["か", "き", "く", "け", "こ"],
  さ: ["さ", "し", "す", "せ", "そ"],
  た: ["た", "ち", "つ", "て", "と"],
  な: ["な", "に", "ぬ", "ね", "の"],
  は: ["は", "ひ", "ふ", "へ", "ほ"],
  ま: ["ま", "み", "む", "め", "も"],
  や: ["や", "ゆ", "よ"],
  ら: ["ら", "り", "る", "れ", "ろ"],
  わ: ["わ", "ゐ", "ゑ", "を", "ん"],
};

/* ============================= データ取得と整形 ============================= */
const raw = listComediansCanonicalOnlyWithRelatedRanksAndBirthDate();

// 1) 読みを付与
const enriched = raw.map(r => {
  const reading = decideReading(r.name, r.reading);
  return {
    ...r,
    reading,
    kind: r.kind as "unit" | "person",
    m1_rank_sort: r.m1_rank_sort,
    koc_rank_sort: r.koc_rank_sort,
    r1_rank_sort: r.r1_rank_sort
  };
});

// 2) 行→サブキーの2段バケット
type Item = {
  id: string;
  name: string;
  reading: string;
  kind: "unit" | "person";
  m1_rank_sort: number | null;   // 例: 1, 2, 4, 50, 100, 500... / null
  koc_rank_sort: number | null;
  r1_rank_sort: number | null;
  birth_date?: string | null;    // 時系列ソート用
  birth_year?: number | null;    // 時系列ソート用
};
type RowBuckets = Record<string, Record<string, Item[]>>;
const rowBuckets: RowBuckets = {};

// 行の初期化
for (const g of groups) {
  rowBuckets[g.key] = {};
  for (const sub of rowSubs[g.key]) rowBuckets[g.key][sub] = [];
}
const others: Item[] = [];

// 分配
for (const r of enriched) {
  const rd = r.reading;
  const head = rd ? headKana(rd) : "";
  const baseHead = head ? toBaseHead(head) : "";

  const gi = baseHead ? groupIndex(baseHead) : -1;
  if (gi < 0) {
    others.push({
      id: r.id,
      name: r.name,
      reading: rd,
      kind: r.kind,
      m1_rank_sort: r.m1_rank_sort,
      koc_rank_sort: r.koc_rank_sort,
      r1_rank_sort: r.r1_rank_sort
    });
    continue;
  }
  const rowKey = groups[gi].key;
  const subList = rowSubs[rowKey];

  // サブキー決定：baseHead が行の母音列にあればそれ、特例として「ん」はわ行の「ん」
  const subKey =
    subList.includes(baseHead)
      ? baseHead
      : baseHead === "ん" && rowKey === "わ"
      ? "ん"
      : subList[0]; // 万一取りこぼしがあれば行の先頭へ

  rowBuckets[rowKey][subKey].push({
    id: r.id,
    name: r.name,
    reading: rd,
    kind: r.kind,
    m1_rank_sort: r.m1_rank_sort,
    koc_rank_sort: r.koc_rank_sort,
    r1_rank_sort: r.r1_rank_sort
  });
}

// 3) ソート（各サブバケット内を reading→name）
const collator = new Intl.Collator("ja", { sensitivity: "base", usage: "sort" });
const sortKey = (s: string, fallback: string) => (s && s.length ? s : fallback);

for (const rowKey of Object.keys(rowBuckets)) {
  for (const subKey of Object.keys(rowBuckets[rowKey])) {
    rowBuckets[rowKey][subKey].sort((a, b) => {
      const ak = sortKey(a.reading, a.name);
      const bk = sortKey(b.reading, b.name);
      const c = collator.compare(ak, bk);
      return c !== 0 ? c : collator.compare(a.name, b.name);
    });
  }
}
others.sort((a, b) => {
  const ak = sortKey(a.reading, a.name);
  const bk = sortKey(b.reading, b.name);
  const c = collator.compare(ak, bk);
  return c !== 0 ? c : collator.compare(a.name, b.name);
});

/* ============================= 日付計算ユーティリティ ============================= */
// 環境変数VITE_BUILD_DATEがあればそれを使い、なければ現在日時を使用
const buildDate = import.meta.env.VITE_BUILD_DATE;

// 日本時間での日付を作成
let TODAY: Date;
if (buildDate) {
  // YYYY-MM-DD形式から年、月、日を分解
  const [year, month, day] = buildDate.split('-').map(Number);
  // Dateコンストラクタを使用（月は0ベースなので-1）
  TODAY = new Date(year, month - 1, day);
} else {
  TODAY = new Date();
}

// birth_date文字列から日付オブジェクトを作成（デフォルト補完あり）
function parseDate(dateStr: string | null): Date | null {
  if (!dateStr || dateStr.trim() === '') return null;
  
  const normalized = dateStr.replace(/年|月|日/g, '/').replace(/\/+/g, '/').replace(/\/$/, '');
  const parts = normalized.split('/').map(p => parseInt(p.trim()));
  
  if (parts.length === 0 || isNaN(parts[0])) return null;
  
  const year = parts[0];
  const month = parts.length >= 2 && !isNaN(parts[1]) ? parts[1] : 4; // デフォルト4月
  const day = parts.length >= 3 && !isNaN(parts[2]) ? parts[2] : 1;   // デフォルト1日
  
  return new Date(year, month - 1, day); // monthは0ベース
}

// 今日基準での経過年数計算
function getYearsFromToday(date: Date): number {
  const diffMs = TODAY.getTime() - date.getTime();
  const diffYears = diffMs / (1000 * 60 * 60 * 24 * 365.25);
  return Math.floor(diffYears);
}

// 年度基準での経過年数計算（結成日は1月基準、誕生日は4月基準）
function getYearsFromYearBase(date: Date, isFormation: boolean): number {
  if (isFormation) {
    // 結成日は1月基準
    const baseMonth = 0; // 1月（0ベース）
    const baseDay = 1;   // 1月1日
    
    let currentYear = TODAY.getFullYear();
    let currentYearBase = new Date(currentYear, baseMonth, baseDay);
    
    // 今日がまだ今年の1月1日前なら、去年基準に
    if (TODAY < currentYearBase) {
      currentYear--;
      currentYearBase = new Date(currentYear, baseMonth, baseDay);
    }
    
    // 対象日が属する年を計算
    let targetYear = date.getFullYear();
    let targetYearBase = new Date(targetYear, baseMonth, baseDay);
    
    if (date < targetYearBase) {
      targetYear--;
    }
    
    return currentYear - targetYear;
  } else {
    // 誕生日は4月基準（従来通り）
    const baseMonth = 3; // 4月（0ベース）
    const baseDay = 2;   // 4月2日
    
    let currentYear = TODAY.getFullYear();
    let currentAprilBase = new Date(currentYear, baseMonth, baseDay);
    
    // 今日がまだ今年の基準日前なら、去年基準に
    if (TODAY < currentAprilBase) {
      currentYear--;
      currentAprilBase = new Date(currentYear, baseMonth, baseDay);
    }
    
    // 対象日が属する年度を計算
    let targetYear = date.getFullYear();
    let targetAprilBase = new Date(targetYear, baseMonth, baseDay);
    
    if (date < targetAprilBase) {
      targetYear--;
    }
    
    return currentYear - targetYear;
  }
}

// 年齢・経過年数の表示文字列生成
function formatYearsLabel(years: number, baseType: 'today' | 'april', sortType: 'formation' | 'birthday'): string {
  if (sortType === 'formation') {
    return baseType === 'today' 
      ? `現在結成${years}年`
      : `今年結成${years}年`;
  } else {
    return baseType === 'today'
      ? `現在${years}歳`
      : `今年度${years}歳`;
  }
}

// 期間表示の生成
function formatPeriodLabel(years: number, baseType: 'today' | 'april', sortType: 'formation' | 'birthday'): string {
  const currentYear = TODAY.getFullYear();
  const currentMonth = TODAY.getMonth() + 1;
  const currentDay = TODAY.getDate();
  
  if (baseType === 'today') {
    const endYear = currentYear - years;
    const endMonth = currentMonth;
    const endDay = currentDay;
    
    // 1年前の日付を計算
    const startYear = endYear - 1;
    const startMonth = currentMonth;
    const startDay = currentDay + 1; // 翌日から
    
    // 日付調整
    const startDate = new Date(startYear, startMonth - 1, startDay);
    const endDate = new Date(endYear, endMonth - 1, endDay);
    
    return `（${startDate.getFullYear()}年${startDate.getMonth() + 1}月${startDate.getDate()}日〜${endDate.getFullYear()}年${endDate.getMonth() + 1}月${endDate.getDate()}日${sortType === 'formation' ? '結成' : '生まれ'}）`;
  } else {
    const endYear = currentYear - years;
    const startYear = endYear - 1;
    if (sortType === 'formation') {
      // 結成日は1月基準
      return `（${startYear}年1月1日〜${endYear}年12月31日結成）`;
    } else {
      // 誕生日は4月基準（従来通り）
      return `（${startYear}年4月2日〜${endYear}年4月1日生まれ）`;
    }
  }
}

/* ============================= 年ごとのソート機能 ============================= */
// 年別グループ化（結成日順・誕生日順）
type YearGroupedData = Record<string, Item[]>;

// 結成日順のデータ作成（ユニットのみ、新しい順）
const formationYearGroups: YearGroupedData = {}; // 旧形式（年ベース）
const formationTodayGroups: Record<string, Item[]> = {}; // 今日基準
const formationAprilGroups: Record<string, Item[]> = {}; // 4月基準
const formationUnknownGroup: Item[] = [];

enriched
  .filter(r => r.kind === "unit")
  .forEach(r => {
    if (r.birth_year) {
      // 旧形式（年ベース）
      const year = r.birth_year.toString();
      if (!formationYearGroups[year]) formationYearGroups[year] = [];
      formationYearGroups[year].push({
        id: r.id,
        name: r.name,
        reading: r.reading,
        kind: r.kind,
        m1_rank_sort: r.m1_rank_sort,
        koc_rank_sort: r.koc_rank_sort,
        r1_rank_sort: r.r1_rank_sort,
        birth_date: r.birth_date,
        birth_year: r.birth_year
      });

      // 新形式（今日基準・年度基準）
      const date = parseDate(r.birth_date);
      if (date) {
        const todayYears = getYearsFromToday(date);
        const yearBaseYears = getYearsFromYearBase(date, true);
        
        const todayKey = todayYears.toString();
        const yearBaseKey = yearBaseYears.toString();
        
        if (!formationTodayGroups[todayKey]) formationTodayGroups[todayKey] = [];
        if (!formationAprilGroups[yearBaseKey]) formationAprilGroups[yearBaseKey] = [];
        
        const item = {
          id: r.id,
          name: r.name,
          reading: r.reading,
          kind: r.kind,
          m1_rank_sort: r.m1_rank_sort,
          koc_rank_sort: r.koc_rank_sort,
          r1_rank_sort: r.r1_rank_sort,
          birth_date: r.birth_date,
          birth_year: r.birth_year
        };
        
        formationTodayGroups[todayKey].push(item);
        formationAprilGroups[yearBaseKey].push(item);
      }
    } else {
      // birth_yearが未設定のユニット
      formationUnknownGroup.push({
        id: r.id,
        name: r.name,
        reading: r.reading,
        kind: r.kind,
        m1_rank_sort: r.m1_rank_sort,
        koc_rank_sort: r.koc_rank_sort,
        r1_rank_sort: r.r1_rank_sort
      });
    }
  });

// 誕生日順のデータ作成（個人のみ、新しい順）
const birthdayYearGroups: YearGroupedData = {}; // 旧形式（年ベース）
const birthdayTodayGroups: Record<string, Item[]> = {}; // 今日基準
const birthdayAprilGroups: Record<string, Item[]> = {}; // 4月基準（4/2基準）
const birthdayUnknownGroup: Item[] = [];

enriched
  .filter(r => r.kind === "person")
  .forEach(r => {
    if (r.birth_year) {
      // 旧形式（年ベース）
      const year = r.birth_year.toString();
      if (!birthdayYearGroups[year]) birthdayYearGroups[year] = [];
      birthdayYearGroups[year].push({
        id: r.id,
        name: r.name,
        reading: r.reading,
        kind: r.kind,
        m1_rank_sort: r.m1_rank_sort,
        koc_rank_sort: r.koc_rank_sort,
        r1_rank_sort: r.r1_rank_sort
      });

      // 新形式（今日基準・年度基準）
      const date = parseDate(r.birth_date);
      if (date) {
        const todayYears = getYearsFromToday(date);
        const yearBaseYears = getYearsFromYearBase(date, false);
        
        const todayKey = todayYears.toString();
        const yearBaseKey = yearBaseYears.toString();
        
        if (!birthdayTodayGroups[todayKey]) birthdayTodayGroups[todayKey] = [];
        if (!birthdayAprilGroups[yearBaseKey]) birthdayAprilGroups[yearBaseKey] = [];
        
        const item = {
          id: r.id,
          name: r.name,
          reading: r.reading,
          kind: r.kind,
          m1_rank_sort: r.m1_rank_sort,
          koc_rank_sort: r.koc_rank_sort,
          r1_rank_sort: r.r1_rank_sort
        };
        
        birthdayTodayGroups[todayKey].push(item);
        birthdayAprilGroups[yearBaseKey].push(item);
      }
    } else {
      // birth_yearが未設定の個人
      birthdayUnknownGroup.push({
        id: r.id,
        name: r.name,
        reading: r.reading,
        kind: r.kind,
        m1_rank_sort: r.m1_rank_sort,
        koc_rank_sort: r.koc_rank_sort,
        r1_rank_sort: r.r1_rank_sort
      });
    }
  });

// 各年のデータを時系列順でソート（年ごとビューでは古い順、新形式のみ）
// 時系列ソート関数（新しい順）
function sortByChronological(a: Item, b: Item): number {
  const dateA = parseDate(a.birth_date || null);
  const dateB = parseDate(b.birth_date || null);
  
  // 日付が両方ある場合は日付順（新しい順）
  if (dateA && dateB) {
    const diff = dateB.getTime() - dateA.getTime();
    if (diff !== 0) return diff;
  }
  
  // 日付が片方のみある場合は、ある方を前に
  if (dateA && !dateB) return -1;
  if (!dateA && dateB) return 1;
  
  // 両方ない場合、または同じ日付の場合は名前順
  const ak = sortKey(a.reading, a.name);
  const bk = sortKey(b.reading, b.name);
  const c = collator.compare(ak, bk);
  return c !== 0 ? c : collator.compare(a.name, b.name);
}

// 新形式（今日基準・4月基準）は時系列順でソート
[formationTodayGroups, formationAprilGroups, birthdayTodayGroups, birthdayAprilGroups].forEach(groups => {
  Object.values(groups).forEach(group => {
    group.sort(sortByChronological);
  });
});

// 旧形式（年ベース）は名前順でソート（互換性のため）
[formationYearGroups, birthdayYearGroups].forEach(groups => {
  Object.values(groups).forEach(group => {
    group.sort((a, b) => {
      const ak = sortKey(a.reading, a.name);
      const bk = sortKey(b.reading, b.name);
      const c = collator.compare(ak, bk);
      return c !== 0 ? c : collator.compare(a.name, b.name);
    });
  });
});

// 未設定グループもソート
formationUnknownGroup.sort((a, b) => {
  const ak = sortKey(a.reading, a.name);
  const bk = sortKey(b.reading, b.name);
  const c = collator.compare(ak, bk);
  return c !== 0 ? c : collator.compare(a.name, b.name);
});

birthdayUnknownGroup.sort((a, b) => {
  const ak = sortKey(a.reading, a.name);
  const bk = sortKey(b.reading, b.name);
  const c = collator.compare(ak, bk);
  return c !== 0 ? c : collator.compare(a.name, b.name);
});

// 年を新しい順にソート（旧形式）
const formationYears = Object.keys(formationYearGroups).sort((a, b) => parseInt(b) - parseInt(a));
const birthdayYears = Object.keys(birthdayYearGroups).sort((a, b) => parseInt(b) - parseInt(a));

// 年代キーを新しい順にソート（新形式）
const formationTodayYears = Object.keys(formationTodayGroups).sort((a, b) => parseInt(a) - parseInt(b));
const formationAprilYears = Object.keys(formationAprilGroups).sort((a, b) => parseInt(a) - parseInt(b));
const birthdayTodayYears = Object.keys(birthdayTodayGroups).sort((a, b) => parseInt(a) - parseInt(b));
const birthdayAprilYears = Object.keys(birthdayAprilGroups).sort((a, b) => parseInt(a) - parseInt(b));
---

<Base title="芸人一覧">
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <span>芸人一覧</span>
  </nav>

  <h1>
    芸人一覧
    <span id="co-count" class="co-count"></span>
  </h1>

  <div class="co-filter">
    <div class="co-filter-row">
      <!-- ソート順選択 -->
      <div id="sort-tabs" class="kind-tabs" data-sort="reading">
        <span class="result-label">表示モード:</span>
        <button type="button" class="kind-tab is-active" data-sort="reading">五十音順</button>
        <button type="button" class="kind-tab" data-sort="formation">ユニット結成年順</button>
        <button type="button" class="kind-tab" data-sort="birthday">個人年齢順</button>
      </div>
    </div>
    
    <div class="co-filter-row" id="base-filter-row" style="display: none;">
      <!-- 基準選択（年ごとソート時のみ表示） -->
      <div id="base-tabs" class="kind-tabs" data-base="today">
        <span class="result-label">基準:</span>
        <button type="button" class="kind-tab is-active" data-base="today">今日基準</button>
        <button type="button" class="kind-tab" data-base="april">4月基準</button>
      </div>
    </div>
    
    <div class="co-filter-row" id="kind-filter-row">
      <!-- 種別タブ（五十音順時のみ表示） -->
      <div id="kind-tabs" class="kind-tabs" data-kind="all">
        <button type="button" class="kind-tab is-active" data-kind="all">すべて</button>
        <button type="button" class="kind-tab" data-kind="unit">ユニット</button>
        <button type="button" class="kind-tab" data-kind="person">個人</button>
      </div>
    </div>

    <div class="co-filter-row">
      <!-- M-1 成績タブ -->
      <div id="m1-tabs" class="kind-tabs result-tabs" data-m1="any">
        <span class="result-label">M-1 進出経験:</span>
