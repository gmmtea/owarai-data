---
import Base from "../../layouts/Base.astro";
import { listComediansCanonicalOnlyWithRelatedRanks as listComediansCanonicalOnly } from "../../lib/queries";

const base = import.meta.env.BASE_URL;

/* ============================= かなユーティリティ ============================= */
const canon = (s: string) => s.normalize("NFKC").trim().replace(/\s+/g, " ");
const toHiragana = (s: string) => s.replace(/[\u30A1-\u30F6]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0x60));
const isKanaOnly = (s: string) => /^[\p{sc=Hiragana}\p{sc=Katakana}ー・･・\s]+$/u.test(canon(s));
const stripSymbolsForReading = (s: string) =>
  s.replace(/[・･·\u30FB\uFF65]/g, "")         // 中黒類
   .replace(/[\u0020\u00A0\u3000]/g, "")       // 空白
   .replace(/[()\[\]{}「」『』【】〈〉《》]/g, "") // 括弧
   .replace(/[.,，．\/／]/g, "")               // 句読点など
   .replace(/[-_—–―]/g, "");                   // ハイフン類（長音ーは残す）

// 読みの決定（DBのreading優先。無ければ名前がかなのみなら推測）
const decideReading = (name: string, reading: string | null) => {
  if (reading && reading.trim() !== "") return reading;
  if (isKanaOnly(name)) return stripSymbolsForReading(toHiragana(canon(name)));
  return ""; // 推測不能
};

// 先頭かなの基底化（濁点・半濁点を無声化／小書きを正字へ）
const toBaseHead = (ch: string): string => {
  const h = toHiragana(ch);
  const devoiced = h
    .replace(/[が]/g, "か").replace(/[ぎ]/g, "き").replace(/[ぐ]/g, "く").replace(/[げ]/g, "け").replace(/[ご]/g, "こ")
    .replace(/[ざ]/g, "さ").replace(/[じ]/g, "し").replace(/[ず]/g, "す").replace(/[ぜ]/g, "せ").replace(/[ぞ]/g, "そ")
    .replace(/[だ]/g, "た").replace(/[ぢ]/g, "ち").replace(/[づ]/g, "つ").replace(/[で]/g, "て").replace(/[ど]/g, "と")
    .replace(/[ば]/g, "は").replace(/[び]/g, "ひ").replace(/[ぶ]/g, "ふ").replace(/[べ]/g, "へ").replace(/[ぼ]/g, "ほ")
    .replace(/[ぱ]/g, "は").replace(/[ぴ]/g, "ひ").replace(/[ぷ]/g, "ふ").replace(/[ぺ]/g, "へ").replace(/[ぽ]/g, "ほ")
    .replace(/[ゔ]/g, "う");
  const normalized = devoiced
    .replace(/^ゃ/, "や").replace(/^ゅ/, "ゆ").replace(/^ょ/, "よ")
    .replace(/^ぁ/, "あ").replace(/^ぃ/, "い").replace(/^ぅ/, "う").replace(/^ぇ/, "え").replace(/^ぉ/, "お")
    .replace(/^ゎ/, "わ").replace(/^っ/, "つ");
  return normalized[0] ?? "";
};

// 読みの先頭ひらがな1文字を抽出（記号・長音をスキップ）
const headKana = (s: string): string => {
  const t = stripSymbolsForReading(s).replace(/ー+/g, ""); // 長音は先頭判定から除外
  const m = t.match(/[\p{sc=Hiragana}]/u);
  return m ? m[0] : "";
};

/* ============================= 行・サブキー定義 ============================= */
const groups = [
  { key: "あ", set: "あいうえお" },
  { key: "か", set: "かきくけこがぎぐげご" },
  { key: "さ", set: "さしすせそざじずぜぞ" },
  { key: "た", set: "たちつてとだぢづでど" },
  { key: "な", set: "なにぬねの" },
  { key: "は", set: "はひふへほばびぶべぼぱぴぷぺぽ" },
  { key: "ま", set: "まみむめも" },
  { key: "や", set: "やゆよ" },
  { key: "ら", set: "らりるれろ" },
  { key: "わ", set: "わゐゑをん" }, // ん はここへ寄せる
];
const groupIndex = (ch: string) => {
  const h = toHiragana(ch);
  for (let i = 0; i < groups.length; i++) {
    if (groups[i].set.includes(h)) return i;
  }
  return -1; // その他
};

// 行ごとのサブキー（見出し用）
const rowSubs: Record<string, string[]> = {
  あ: ["あ", "い", "う", "え", "お"],
  か: ["か", "き", "く", "け", "こ"],
  さ: ["さ", "し", "す", "せ", "そ"],
  た: ["た", "ち", "つ", "て", "と"],
  な: ["な", "に", "ぬ", "ね", "の"],
  は: ["は", "ひ", "ふ", "へ", "ほ"],
  ま: ["ま", "み", "む", "め", "も"],
  や: ["や", "ゆ", "よ"],
  ら: ["ら", "り", "る", "れ", "ろ"],
  わ: ["わ", "ゐ", "ゑ", "を", "ん"],
};

/* ============================= データ取得と整形 ============================= */
const raw = listComediansCanonicalOnly();

// 1) 読みを付与
const enriched = raw.map(r => {
  const reading = decideReading(r.name, r.reading);
  return {
    ...r,
    reading,
    kind: r.kind as "unit" | "person",
    m1_rank_sort: r.m1_rank_sort,
    koc_rank_sort: r.koc_rank_sort,
    r1_rank_sort: r.r1_rank_sort
  };
});

// 2) 行→サブキーの2段バケット
type Item = {
  id: string;
  name: string;
  reading: string;
  kind: "unit" | "person";
  m1_rank_sort: number | null;   // 例: 1, 2, 4, 50, 100, 500... / null
  koc_rank_sort: number | null;
  r1_rank_sort: number | null;
};
type RowBuckets = Record<string, Record<string, Item[]>>;
const rowBuckets: RowBuckets = {};

// 行の初期化
for (const g of groups) {
  rowBuckets[g.key] = {};
  for (const sub of rowSubs[g.key]) rowBuckets[g.key][sub] = [];
}
const others: Item[] = [];

// 分配
for (const r of enriched) {
  const rd = r.reading;
  const head = rd ? headKana(rd) : "";
  const baseHead = head ? toBaseHead(head) : "";

  const gi = baseHead ? groupIndex(baseHead) : -1;
  if (gi < 0) {
    others.push({
      id: r.id,
      name: r.name,
      reading: rd,
      kind: r.kind,
      m1_rank_sort: r.m1_rank_sort,
      koc_rank_sort: r.koc_rank_sort,
      r1_rank_sort: r.r1_rank_sort
    });
    continue;
  }
  const rowKey = groups[gi].key;
  const subList = rowSubs[rowKey];

  // サブキー決定：baseHead が行の母音列にあればそれ、特例として「ん」はわ行の「ん」
  const subKey =
    subList.includes(baseHead)
      ? baseHead
      : baseHead === "ん" && rowKey === "わ"
      ? "ん"
      : subList[0]; // 万一取りこぼしがあれば行の先頭へ

  rowBuckets[rowKey][subKey].push({
    id: r.id,
    name: r.name,
    reading: rd,
    kind: r.kind,
    m1_rank_sort: r.m1_rank_sort,
    koc_rank_sort: r.koc_rank_sort,
    r1_rank_sort: r.r1_rank_sort
  });
}

// 3) ソート（各サブバケット内を reading→name）
const collator = new Intl.Collator("ja", { sensitivity: "base", usage: "sort" });
const sortKey = (s: string, fallback: string) => (s && s.length ? s : fallback);

for (const rowKey of Object.keys(rowBuckets)) {
  for (const subKey of Object.keys(rowBuckets[rowKey])) {
    rowBuckets[rowKey][subKey].sort((a, b) => {
      const ak = sortKey(a.reading, a.name);
      const bk = sortKey(b.reading, b.name);
      const c = collator.compare(ak, bk);
      return c !== 0 ? c : collator.compare(a.name, b.name);
    });
  }
}
others.sort((a, b) => {
  const ak = sortKey(a.reading, a.name);
  const bk = sortKey(b.reading, b.name);
  const c = collator.compare(ak, bk);
  return c !== 0 ? c : collator.compare(a.name, b.name);
});
---

<Base title="芸人一覧">
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <span>芸人一覧</span>
  </nav>

  <h1>
    芸人一覧
    <span id="co-count" class="co-count"></span>
  </h1>

  <div class="co-filter">
    <div class="co-filter-row">
      <!-- 種別タブ -->
      <div id="kind-tabs" class="kind-tabs" data-kind="all">
        <button type="button" class="kind-tab is-active" data-kind="all">すべて</button>
        <button type="button" class="kind-tab" data-kind="unit">ユニット</button>
        <button type="button" class="kind-tab" data-kind="person">個人</button>
      </div>
    </div>

    <div class="co-filter-row">
      <!-- M-1 成績タブ -->
      <div id="m1-tabs" class="kind-tabs result-tabs" data-m1="any">
        <span class="result-label">M-1 進出経験:</span>
        <button type="button" class="kind-tab is-active" data-m1="any">指定なし</button>
        <button type="button" class="kind-tab" data-m1="quarter">準々決勝</button>
        <button type="button" class="kind-tab" data-m1="semi">準決勝</button>
        <button type="button" class="kind-tab" data-m1="final">決勝</button>
        <button type="button" class="kind-tab" data-m1="win">優勝</button>
      </div>
    </div>

    <div class="co-filter-row">
      <!-- KOC 成績タブ -->
      <div id="koc-tabs" class="kind-tabs result-tabs" data-koc="any">
        <span class="result-label">KOC 進出経験:</span>
        <button type="button" class="kind-tab is-active" data-koc="any">指定なし</button>
        <button type="button" class="kind-tab" data-koc="semi">準決勝</button>
        <button type="button" class="kind-tab" data-koc="final">決勝</button>
        <button type="button" class="kind-tab" data-koc="win">優勝</button>
      </div>
    </div>

    <div class="co-filter-row">
      <!-- R-1 成績タブ -->
      <div id="r1-tabs" class="kind-tabs result-tabs" data-r1="any">
        <span class="result-label">R-1 進出経験:</span>
        <button type="button" class="kind-tab is-active" data-r1="any">指定なし</button>
        <button type="button" class="kind-tab" data-r1="semi">準決勝</button>
        <button type="button" class="kind-tab" data-r1="final">決勝</button>
        <button type="button" class="kind-tab" data-r1="win">優勝</button>
      </div>
    </div>
  </div>

  {/* 表示：サブキー1文字を太字＋コロンで先頭に置く */}
  {groups.map((g) => {
    const row = rowBuckets[g.key];
    const nonEmptySubs = Object.entries(row).filter(([, arr]) => arr.length > 0);

    // この行に1件も無いなら、見出しごと出さない
    if (nonEmptySubs.length === 0) return null;

    return (
      <section class="co-row" data-row-key={g.key}>
        <h2 id={`row-${g.key}`}>{g.key}行</h2>

        {nonEmptySubs.map(([sub, arr]) => (
          <p class="name-line">
            <strong>{sub}</strong>:{" "}
            {arr.map((it, i) => (
              <span
                class="co-item"
                data-kind={it.kind}
                data-m1-rank={it.m1_rank_sort ?? ""}
                data-koc-rank={it.koc_rank_sort ?? ""}
                data-r1-rank={it.r1_rank_sort ?? ""}
              >
                {i > 0 && " / "}
                <a class="co-link" href={`${base}co/${it.id}`}>{it.name}</a>
              </span>
            ))}
          </p>
        ))}
      </section>
    );
  })}

  {/* その他芸人（ラテン文字・漢字のみ等） */}
  {others.length > 0 && (
    <section class="co-row-section" data-row="others">
      <h2>その他</h2>
      <p class="name-line">
        {others.map((it, i) => (
          <span
            class="co-item"
            data-kind={it.kind}
            data-m1-rank={it.m1_rank_sort ?? ""}
            data-koc-rank={it.koc_rank_sort ?? ""}
            data-r1-rank={it.r1_rank_sort ?? ""}
          >
            {i > 0 && " / "}
            <a class="co-link" href={`${base}co/${it.id}`}>{it.name}</a>
          </span>
        ))}
      </p>
    </section>
  )}
</Base>

<style>
  .name-line { line-height: 1.9; }
  .name-line a { white-space: nowrap; }
  .subindex { margin: .25rem 0 1rem; font-size: .95rem; }
  .subindex a { text-decoration: none; border-bottom: 1px dotted currentColor; }
  .subindex .muted { opacity: .4; }
  .subgroup h3 { margin: .75rem 0 .25rem; font-size: 1.05rem; }

  .kind-tabs {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 1rem;
    flex-wrap: wrap;
  }
  .kind-tab {
    border: 1px solid var(--border, #ccc);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .kind-tab.is-active {
    background: var(--accent-weak, #eef6ff);
    font-weight: 600;
  }
  .co-count {
    margin-left: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted, #666);
  }
  .co-item[hidden] {
    display: none;
  }

  .co-filter {
    margin: 0.75rem 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .co-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .result-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .result-label {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  /* すべて hidden の行は非表示 */
  .name-line.is-empty {
    display: none;
  }
</style>

<script is:inline>
  const STORAGE_KEY = 'co.index.filter';
  const KIND_ALLOWED = ['all', 'unit', 'person'];
  const RESULT_ALLOWED = ['any', 'quarter', 'semi', 'final', 'win'];

  const nameLines = Array.from(
    document.querySelectorAll('.name-line')
  );
  const coItems = Array.from(
    document.querySelectorAll('.co-item')
  );
  const countEl = document.getElementById('co-count');

  function parseRankSort(v) {
    if (v == null || v === '') return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  }

  function matchKind(itemKind, cond) {
    if (cond === 'all') return true;
    return itemKind === cond;
  }

  // rank_sort の規則:
  // 1: 優勝, 2: 準優勝, 4〜12: 決勝順位, 50: 準決勝, 100: 準々決勝...
  function matchResultFilter(rankSort, cond) {
    if (cond === 'any') return true;
    if (rankSort == null) return false;

    if (cond === 'win')   return rankSort === 1;
    if (cond === 'final') return rankSort <= 12;
    if (cond === 'semi')  return rankSort <= 50;
    if (cond === 'quarter') return rankSort <= 100;
    return true;
  }

  function readStateFromUrlAndStorage() {
    const def = { kind: 'all', m1: 'any', koc: 'any', r1: 'any' };

    try {
      const url = new URL(location.href);
      const kindQ = url.searchParams.get('kind');
      const m1Q   = url.searchParams.get('m1');
      const kocQ  = url.searchParams.get('koc');
      const r1Q   = url.searchParams.get('r1');

      const fromUrl = {
        kind: KIND_ALLOWED.includes(kindQ || '') ? kindQ : null,
        m1:   RESULT_ALLOWED.includes(m1Q || '') ? m1Q   : null,
        koc:  RESULT_ALLOWED.includes(kocQ || '') ? kocQ : null,
        r1:   RESULT_ALLOWED.includes(r1Q || '') ? r1Q   : null,
      };
      if (fromUrl.kind || fromUrl.m1 || fromUrl.koc || fromUrl.r1) {
        return {
          kind: fromUrl.kind || def.kind,
          m1:   fromUrl.m1   || def.m1,
          koc:  fromUrl.koc  || def.koc,
          r1:   fromUrl.r1   || def.r1,
        };
      }
    } catch (_) {}

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        const kind = KIND_ALLOWED.includes(parsed.kind) ? parsed.kind : def.kind;
        const m1   = RESULT_ALLOWED.includes(parsed.m1) ? parsed.m1   : def.m1;
        const koc  = RESULT_ALLOWED.includes(parsed.koc) ? parsed.koc : def.koc;
        const r1   = RESULT_ALLOWED.includes(parsed.r1) ? parsed.r1 : def.r1;
        return { kind, m1, koc, r1 };
      }
    } catch (_) {}

    return def;
  }

  function writeStateToUrlAndStorage(state) {
    try {
      const url = new URL(location.href);
      url.searchParams.set('kind', state.kind);
      url.searchParams.set('m1',   state.m1);
      url.searchParams.set('koc',  state.koc);
      url.searchParams.set('r1',   state.r1);
      history.replaceState(null, '', url);
    } catch (_) {}

    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (_) {}
  }

  // 行内の「 / 」と空行判定を更新
  function updateSeparatorsAndEmptyLines() {
    nameLines.forEach(line => {
      const spans = Array.from(line.querySelectorAll('.co-item'));
      const visibles = spans.filter(s => !s.hasAttribute('hidden'));

      if (visibles.length === 0) {
        line.classList.add('is-empty');
      } else {
        line.classList.remove('is-empty');
      }

      visibles.forEach((span, idx) => {
        let first = span.firstChild;
        if (!first || first.nodeType !== Node.TEXT_NODE) {
          first = span.insertBefore(document.createTextNode(''), span.firstChild);
        }
        first.textContent = idx === 0 ? '' : ' / ';
      });
    });
  }

  function updateCount() {
    if (!countEl) return;
    const visibleCount = coItems.filter(el => !el.hasAttribute('hidden')).length;
    countEl.textContent = `（${visibleCount}件）`;
  }

  function updateRowSectionVisibility() {
    const sections = Array.from(document.querySelectorAll('section.co-row'));
    sections.forEach(sec => {
      const items = Array.from(sec.querySelectorAll('.co-item'));
      const hasVisible = items.some(el => !el.hasAttribute('hidden'));
      sec.hidden = !hasVisible;
    });
  }

  function applyFilter(state) {
    coItems.forEach(el => {
      const itemKind = el.getAttribute('data-kind') || 'unit';
      const m1Rank   = parseRankSort(el.getAttribute('data-m1-rank'));
      const kocRank  = parseRankSort(el.getAttribute('data-koc-rank'));
      const r1Rank   = parseRankSort(el.getAttribute('data-r1-rank'));

      const okKind = matchKind(itemKind, state.kind);
      const okM1   = matchResultFilter(m1Rank, state.m1);
      const okKoc  = matchResultFilter(kocRank, state.koc);
      const okR1   = matchResultFilter(r1Rank, state.r1);

      const show = okKind && okM1 && okKoc && okR1;
      if (show) {
        el.removeAttribute('hidden');
      } else {
        el.setAttribute('hidden', 'true');
      }
    });

    updateSeparatorsAndEmptyLines();
    updateRowSectionVisibility();
    updateCount();
  }

  function setActiveTab(container, attrName, value) {
    if (!container) return;
    container.setAttribute(`data-${attrName}`, value);
    const buttons = Array.from(container.querySelectorAll('.kind-tab'));
    buttons.forEach(b => {
      b.classList.toggle('is-active', b.dataset[attrName] === value);
    });
  }

  function syncTabs(state) {
    setActiveTab(document.getElementById('kind-tabs'), 'kind', state.kind);
    setActiveTab(document.getElementById('m1-tabs'),   'm1',   state.m1);
    setActiveTab(document.getElementById('koc-tabs'),  'koc',  state.koc);
    setActiveTab(document.getElementById('r1-tabs'),   'r1',   state.r1);
  }

  function setupFilter() {
    const kindWrap = document.getElementById('kind-tabs');
    const m1Wrap   = document.getElementById('m1-tabs');
    const kocWrap  = document.getElementById('koc-tabs');
    const r1Wrap   = document.getElementById('r1-tabs');
    if (!kindWrap || !m1Wrap || !kocWrap || !r1Wrap) return;

    let state = readStateFromUrlAndStorage();
    syncTabs(state);
    applyFilter(state);

    function wireTabs(container, attrName, onChange) {
      const buttons = Array.from(container.querySelectorAll('.kind-tab'));
      buttons.forEach(b => {
        b.addEventListener('click', () => {
          const v = b.dataset[attrName];
          if (!v) return;
          onChange(v);
        });
      });
    }

    wireTabs(kindWrap, 'kind', (v) => {
      state = { ...state, kind: v };
      setActiveTab(kindWrap, 'kind', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(m1Wrap, 'm1', (v) => {
      state = { ...state, m1: v };
      setActiveTab(m1Wrap, 'm1', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(kocWrap, 'koc', (v) => {
      state = { ...state, koc: v };
      setActiveTab(kocWrap, 'koc', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(r1Wrap, 'r1', (v) => {
      state = { ...state, r1: v };
      setActiveTab(r1Wrap, 'r1', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    window.addEventListener('popstate', () => {
      const st = readStateFromUrlAndStorage();
      state = st;
      syncTabs(state);
      applyFilter(state);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFilter);
</script>
