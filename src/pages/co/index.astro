  .name-line a { white-space: nowrap; }
  .subindex { margin: .25rem 0 1rem; font-size: .95rem; }
  .subindex a { text-decoration: none; border-bottom: 1px dotted currentColor; }
  .subindex .muted { opacity: .4; }
  .subgroup h3 { margin: .75rem 0 .25rem; font-size: 1.05rem; }

  .period-label {
    font-size: 0.8rem;
    font-weight: normal;
    color: var(--muted, #666);
    margin-left: 0.5rem;
  }

  .kind-tabs {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 1rem;
    flex-wrap: wrap;
  }
  .kind-tab {
    border: 1px solid var(--border, #ccc);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .kind-tab.is-active {
    background: var(--accent-weak, #eef6ff);
    font-weight: 600;
  }
  .co-count {
    margin-left: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted, #666);
  }
  .co-item[hidden] {
    display: none;
  }

  .co-filter {
    margin: 0.75rem 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .co-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .result-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .result-label {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  /* すべて hidden の行は非表示 */
  .name-line.is-empty {
    display: none;
  }
</style>

<script is:inline>
  const STORAGE_KEY = 'co.index.filter';
  const KIND_ALLOWED = ['all', 'unit', 'person'];
  const RESULT_ALLOWED = ['any', 'quarter', 'semi', 'final', 'win'];
  const SORT_ALLOWED = ['reading', 'formation', 'birthday'];
  const BASE_ALLOWED = ['today', 'april'];

  const nameLines = Array.from(
    document.querySelectorAll('.name-line')
  );
  // 読み仮名ビューのアイテムのみ（メインのフィルタリング対象）
  const coItems = Array.from(
    document.querySelectorAll('#reading-view .co-item')
  );
  const countEl = document.getElementById('co-count');

  // ソート表示の切り替え
  function showSortView(sortType, baseType = 'today') {
    const views = ['reading-view', 'formation-view', 'birthday-view'];
    views.forEach(id => {
      const view = document.getElementById(id);
      if (view) {
        view.style.display = (id === `${sortType}-view`) ? 'block' : 'none';
      }
    });
    
    // 種別選択UIの表示/非表示（五十音順のみ表示）
    const kindFilterRow = document.getElementById('kind-filter-row');
    if (kindFilterRow) {
      kindFilterRow.style.display = (sortType === 'reading') ? 'block' : 'none';
    }
    
    // 基準選択UIの表示/非表示（年ベース順のみ表示）
    const baseFilterRow = document.getElementById('base-filter-row');
    if (baseFilterRow) {
      baseFilterRow.style.display = (sortType === 'reading') ? 'none' : 'block';
    }
    
    // 基準ボタンのラベルを更新
    updateBaseTabLabels(sortType);
    
    // 年ごと表示の場合、基準も切り替え
    if (sortType === 'formation' || sortType === 'birthday') {
      showBaseView(sortType, baseType);
    }
  }

  // 表示モード切り替え時のkind値自動調整
  function adjustKindForSortType(sortType, currentKind) {
    if (sortType === 'reading') {
      // 五十音順：現在の値を維持
      return currentKind;
    } else if (sortType === 'formation') {
      // 結成年順：ユニットのみ表示可能なので'unit'に固定
      return 'unit';
    } else if (sortType === 'birthday') {
      // 誕生日順：個人のみ表示可能なので'person'に固定
      return 'person';
    }
    return currentKind;
  }

  // 基準ボタンのラベルを更新
  function updateBaseTabLabels(sortType) {
    const aprilButton = document.querySelector('#base-tabs button[data-base="april"]');
    if (aprilButton) {
      if (sortType === 'formation') {
        aprilButton.textContent = '1月基準';
      } else {
        aprilButton.textContent = '4月基準';
      }
    }
  }

  // 基準表示の切り替え（今日基準 vs 4月基準）
  function showBaseView(sortType, baseType) {
    if (sortType === 'reading') return;
    
    const todayView = document.getElementById(`${sortType}-today`);
    const aprilView = document.getElementById(`${sortType}-april`);
    
    if (todayView) todayView.style.display = (baseType === 'today') ? 'block' : 'none';
    if (aprilView) aprilView.style.display = (baseType === 'april') ? 'block' : 'none';
  }

  function parseRankSort(v) {
    if (v == null || v === '') return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  }

  function matchKind(itemKind, cond) {
    if (cond === 'all') return true;
    return itemKind === cond;
  }

  // rank_sort の規則:
  // 1: 優勝, 2: 準優勝, 4〜12: 決勝順位, 50: 準決勝, 100: 準々決勝...
  function matchResultFilter(rankSort, cond) {
    if (cond === 'any') return true;
    if (rankSort == null) return false;

    if (cond === 'win')   return rankSort === 1;
    if (cond === 'final') return rankSort <= 12;
    if (cond === 'semi')  return rankSort <= 50;
    if (cond === 'quarter') return rankSort <= 100;
    return true;
  }

  function readStateFromUrlAndStorage() {
    const def = { sort: 'reading', base: 'today', kind: 'all', m1: 'any', koc: 'any', r1: 'any' };

    try {
      const url = new URL(location.href);
      const sortQ = url.searchParams.get('sort');
      const baseQ = url.searchParams.get('base');
      const kindQ = url.searchParams.get('kind');
      const m1Q   = url.searchParams.get('m1');
      const kocQ  = url.searchParams.get('koc');
      const r1Q   = url.searchParams.get('r1');

      const fromUrl = {
        sort: SORT_ALLOWED.includes(sortQ || '') ? sortQ : null,
        base: BASE_ALLOWED.includes(baseQ || '') ? baseQ : null,
        kind: KIND_ALLOWED.includes(kindQ || '') ? kindQ : null,
        m1:   RESULT_ALLOWED.includes(m1Q || '') ? m1Q   : null,
        koc:  RESULT_ALLOWED.includes(kocQ || '') ? kocQ : null,
        r1:   RESULT_ALLOWED.includes(r1Q || '') ? r1Q   : null,
      };
      if (fromUrl.sort || fromUrl.base || fromUrl.kind || fromUrl.m1 || fromUrl.koc || fromUrl.r1) {
        return {
          sort: fromUrl.sort || def.sort,
          base: fromUrl.base || def.base,
          kind: fromUrl.kind || def.kind,
          m1:   fromUrl.m1   || def.m1,
          koc:  fromUrl.koc  || def.koc,
          r1:   fromUrl.r1   || def.r1,
        };
      }
    } catch (_) {}

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        const sort = SORT_ALLOWED.includes(parsed.sort) ? parsed.sort : def.sort;
        const base = BASE_ALLOWED.includes(parsed.base) ? parsed.base : def.base;
        const kind = KIND_ALLOWED.includes(parsed.kind) ? parsed.kind : def.kind;
        const m1   = RESULT_ALLOWED.includes(parsed.m1) ? parsed.m1   : def.m1;
        const koc  = RESULT_ALLOWED.includes(parsed.koc) ? parsed.koc : def.koc;
        const r1   = RESULT_ALLOWED.includes(parsed.r1) ? parsed.r1 : def.r1;
        return { sort, base, kind, m1, koc, r1 };
      }
    } catch (_) {}

    return def;
  }

  function writeStateToUrlAndStorage(state) {
    try {
      const url = new URL(location.href);
      url.searchParams.set('sort', state.sort);
      url.searchParams.set('base', state.base);
      url.searchParams.set('kind', state.kind);
      url.searchParams.set('m1',   state.m1);
      url.searchParams.set('koc',  state.koc);
      url.searchParams.set('r1',   state.r1);
      history.replaceState(null, '', url);
    } catch (_) {}

    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (_) {}
  }

  // 行内の「 / 」と空行判定を更新
  function updateSeparatorsAndEmptyLines() {
    nameLines.forEach(line => {
      const spans = Array.from(line.querySelectorAll('.co-item'));
      const visibles = spans.filter(s => !s.hasAttribute('hidden'));

      if (visibles.length === 0) {
        line.classList.add('is-empty');
      } else {
        line.classList.remove('is-empty');
      }

      visibles.forEach((span, idx) => {
        let first = span.firstChild;
        if (!first || first.nodeType !== Node.TEXT_NODE) {
          first = span.insertBefore(document.createTextNode(''), span.firstChild);
        }
        first.textContent = idx === 0 ? '' : ' / ';
      });
    });
  }

  function updateCount(currentSort = 'reading', currentBase = 'today') {
    if (!countEl) return;
    
    let visibleCount = 0;
    
    if (currentSort === 'reading') {
      // 読み仮名ビューの場合
      visibleCount = coItems.filter(el => !el.hasAttribute('hidden')).length;
    } else {
      // 年ごとビューの場合、現在表示されている基準のビューのみをカウント
      const currentBaseViewId = `${currentSort}-${currentBase}`;
      const currentBaseView = document.getElementById(currentBaseViewId);
      if (currentBaseView && currentBaseView.style.display !== 'none') {
        const viewItems = Array.from(currentBaseView.querySelectorAll('.co-item'));
        visibleCount = viewItems.filter(el => !el.hasAttribute('hidden')).length;
      }
    }
    
    countEl.textContent = `（${visibleCount}件）`;
  }

  function updateRowSectionVisibility() {
    const sections = Array.from(document.querySelectorAll('section.co-row'));
    sections.forEach(sec => {
      const items = Array.from(sec.querySelectorAll('.co-item'));
      const hasVisible = items.some(el => !el.hasAttribute('hidden'));
      sec.hidden = !hasVisible;
    });
  }

  function applyFilter(state) {
    // 読み仮名ビューのフィルタリング
    coItems.forEach(el => {
      const itemKind = el.getAttribute('data-kind') || 'unit';
      const m1Rank   = parseRankSort(el.getAttribute('data-m1-rank'));
      const kocRank  = parseRankSort(el.getAttribute('data-koc-rank'));
      const r1Rank   = parseRankSort(el.getAttribute('data-r1-rank'));

      const okKind = matchKind(itemKind, state.kind);
      const okM1   = matchResultFilter(m1Rank, state.m1);
      const okKoc  = matchResultFilter(kocRank, state.koc);
      const okR1   = matchResultFilter(r1Rank, state.r1);

      const show = okKind && okM1 && okKoc && okR1;
      if (show) {
        el.removeAttribute('hidden');
      } else {
        el.setAttribute('hidden', 'true');
      }
    });

    // 年ごとビューのフィルタリング
    const yearViewItems = Array.from(document.querySelectorAll('#formation-view .co-item, #birthday-view .co-item'));
    yearViewItems.forEach(el => {
      const itemKind = el.getAttribute('data-kind') || 'unit';
      const m1Rank   = parseRankSort(el.getAttribute('data-m1-rank'));
      const kocRank  = parseRankSort(el.getAttribute('data-koc-rank'));
      const r1Rank   = parseRankSort(el.getAttribute('data-r1-rank'));

      const okKind = matchKind(itemKind, state.kind);
      const okM1   = matchResultFilter(m1Rank, state.m1);
      const okKoc  = matchResultFilter(kocRank, state.koc);
      const okR1   = matchResultFilter(r1Rank, state.r1);

      const show = okKind && okM1 && okKoc && okR1;
      if (show) {
        el.removeAttribute('hidden');
      } else {
        el.setAttribute('hidden', 'true');
      }
    });

    updateSeparatorsAndEmptyLines();
    updateRowSectionVisibility();
    updateCount(state.sort, state.base);
  }

  function setActiveTab(container, attrName, value) {
    if (!container) return;
    container.setAttribute(`data-${attrName}`, value);
    const buttons = Array.from(container.querySelectorAll('.kind-tab'));
    buttons.forEach(b => {
      b.classList.toggle('is-active', b.dataset[attrName] === value);
    });
  }

  function syncTabs(state) {
    setActiveTab(document.getElementById('sort-tabs'), 'sort', state.sort);
    setActiveTab(document.getElementById('base-tabs'), 'base', state.base);
    setActiveTab(document.getElementById('kind-tabs'), 'kind', state.kind);
    setActiveTab(document.getElementById('m1-tabs'),   'm1',   state.m1);
    setActiveTab(document.getElementById('koc-tabs'),  'koc',  state.koc);
    setActiveTab(document.getElementById('r1-tabs'),   'r1',   state.r1);
  }

  function setupFilter() {
    const sortWrap = document.getElementById('sort-tabs');
    const baseWrap = document.getElementById('base-tabs');
    const kindWrap = document.getElementById('kind-tabs');
    const m1Wrap   = document.getElementById('m1-tabs');
    const kocWrap  = document.getElementById('koc-tabs');
    const r1Wrap   = document.getElementById('r1-tabs');
    if (!sortWrap || !baseWrap || !kindWrap || !m1Wrap || !kocWrap || !r1Wrap) return;

    let state = readStateFromUrlAndStorage();
    syncTabs(state);
    applyFilter(state);
    showSortView(state.sort, state.base);

    function wireTabs(container, attrName, onChange) {
      const buttons = Array.from(container.querySelectorAll('.kind-tab'));
      buttons.forEach(b => {
        b.addEventListener('click', () => {
          const v = b.dataset[attrName];
          if (!v) return;
          onChange(v);
        });
      });
    }

    wireTabs(sortWrap, 'sort', (v) => {
      // 新しいソートタイプに適したkind値に自動調整
      const adjustedKind = adjustKindForSortType(v, state.kind);
      
      state = { ...state, sort: v, kind: adjustedKind };
      setActiveTab(sortWrap, 'sort', v);
      setActiveTab(kindWrap, 'kind', adjustedKind);  // kind tabも更新
      showSortView(v, state.base);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(baseWrap, 'base', (v) => {
      state = { ...state, base: v };
      setActiveTab(baseWrap, 'base', v);
      showSortView(state.sort, v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(kindWrap, 'kind', (v) => {
      state = { ...state, kind: v };
      setActiveTab(kindWrap, 'kind', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(m1Wrap, 'm1', (v) => {
      state = { ...state, m1: v };
      setActiveTab(m1Wrap, 'm1', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(kocWrap, 'koc', (v) => {
      state = { ...state, koc: v };
      setActiveTab(kocWrap, 'koc', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    wireTabs(r1Wrap, 'r1', (v) => {
      state = { ...state, r1: v };
      setActiveTab(r1Wrap, 'r1', v);
      writeStateToUrlAndStorage(state);
      applyFilter(state);
    });

    window.addEventListener('popstate', () => {
      const st = readStateFromUrlAndStorage();
      state = st;
      syncTabs(state);
      applyFilter(state);
    });
  }

  document.addEventListener('DOMContentLoaded', setupFilter);
</script>
