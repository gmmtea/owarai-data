---
import Base from "../../layouts/Base.astro";
import type { CoListItem } from "../../lib/queries";
import {
  listCompetitions,
  listComediansCanonicalOnly,
  getComedianTables,
  getComedianTablesByYear,
  getUnitMembers,
  getPersonUnits,
  getRelatedUnitsForUnit,
  getRelatedMembersForPerson
} from "../../lib/queries";
import ResultDataCells from "../../components/ResultDataCells.astro";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const comedians = listComediansCanonicalOnly();
  const ids = comedians.map(c => c.id);
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params as { id: string };
const data = getComedianTables(id);
if (!data) throw new Error("該当データなし");
const { comedian, byComp } = data;

const members: CoListItem[] = getUnitMembers(id);
const units:   CoListItem[] = getPersonUnits(id);

// kind に応じて関連を取得
const relatedUnits:   CoListItem[] = comedian.kind === 'unit'   ? getRelatedUnitsForUnit(id)     : [];
const relatedMembers: CoListItem[] = comedian.kind === 'person' ? getRelatedMembersForPerson(id) : [];

/** 大会ごとに「列メタのユニオン」「全年の行」を事前計算 */
type ColumnMeta = {
  key: string;
  label?: string | null;
  pref_order?: number | null;
  is_multiline?: 0 | 1 | null;
  col_class?: string | null;
  related_key?: string | null;
};
type Section = {
  comp: string;
  competition_name: string;
  columns: ColumnMeta[];
  rows: any[];
  showAlias: boolean;
  hasRelated: boolean;
  hasSelf: boolean;
  hasAliasSelf: boolean;
};

type Source = {
  id: string;
  label: string;
  is_related: boolean;
};

function unionColumns(colsArrays: ColumnMeta[][]): ColumnMeta[] {
  const seen = new Set<string>();
  const out: ColumnMeta[] = [];
  for (const arr of colsArrays) {
    for (const c of arr) {
      if (seen.has(c.key)) continue;
      seen.add(c.key);
      out.push(c);
    }
  }
  // 並び：pref_order → key 安定化
  out.sort((a, b) => {
    const ap = a.pref_order ?? 9_999_999;
    const bp = b.pref_order ?? 9_999_999;
    return ap !== bp ? ap - bp : String(a.key).localeCompare(String(b.key));
  });
  return out;
}

// 文字列が非空かどうか
function isNonEmptyString(v: unknown) {
  return typeof v === "string" ? v.trim() !== "" : v != null;
}

// 列 c が rows の中で1行でも“表示有り”なら true
function columnIsVisible(c: ColumnMeta, rows: any[]) {
  for (const r of rows) {
    // first_order は数値があれば表示（A-2番 の A は first_group 次第だが、数値無ければ空）
    if (c.key === "first_order") {
      const v = r[c.key];
      if (v !== null && v !== undefined && String(v).trim() !== "") return true;
      continue;
    }

    // 連動動画列がある場合は、テキスト or URL のどちらかが埋まっていれば“有り”
    if (c.related_key) {
      const text = r[c.key];
      const url  = r[c.related_key];
      if (isNonEmptyString(text) || isNonEmptyString(url)) return true;
      continue;
    }

    // 通常列
    if (isNonEmptyString(r[c.key])) return true;
  }
  return false;
}

// ===== 本人 + 所属(メンバー/ユニット) の記録を混ぜる =====
const relatedSources: Source[] =
  comedian.kind === "unit"
    ? members.map((m) => ({
        id: m.link_id,
        label: `「${m.name}」の記録`,
        is_related: true,
      }))
    : comedian.kind === "person"
    ? units.map((u) => ({
        id: u.link_id,
        label: `「${u.name}」の記録`,
        is_related: true,
      }))
    : [];

// 重複ID排除（本人と同じIDや、名寄せの都合で重複するケースを潰す）
const sources: Source[] = (() => {
  const m = new Map<string, Source>();
  m.set(id, { id, label: "", is_related: false });
  for (const s of relatedSources) if (!m.has(s.id)) m.set(s.id, s);
  return Array.from(m.values());
})();
const hasAnyRelated = sources.some((s) => s.is_related);

// comp 表示用（byComp を sources 分集約）
const tablesBySource = sources
  .map((s) => ({
    ...s,
    data: s.id === id ? data : getComedianTables(s.id),
  }))
  .filter((x) => !!x.data) as Array<Source & { data: any }>;

const compMap = new Map<
  string,
  { competition_name: string; columnsArrays: ColumnMeta[][]; rows: any[] }
>();

for (const st of tablesBySource) {
  for (const [comp, block] of Object.entries(st.data.byComp ?? {}) as any) {
    const e =
      compMap.get(comp) ??
      {
        competition_name: String(block.competition_name),
        columnsArrays: [] as ColumnMeta[][],
        rows: [] as any[],
      };

    for (const y of (block.years ?? []) as any[]) {
      e.columnsArrays.push((y.columns ?? []) as ColumnMeta[]);
      for (const r of (y.rows ?? []) as any[]) {
        const baseAlias =
          typeof r.alias_label === "string" ? r.alias_label.trim() : "";

        const relatedLabel = st.is_related ? st.label : "";

        e.rows.push({
          ...r,
          // 本人: 大会での名義（alias_label）
          // 関連: 「所属メンバー: ○○」等の関連元ラベルのみ（大会名義は載せない）
          alias_label: st.is_related ? relatedLabel : baseAlias,
          _is_related: st.is_related,
        });
      }
    }
    compMap.set(comp, e);
  }
}

const compOrder = new Map(
  listCompetitions().map((c) => [c.key, c.sort_order] as const)
);

const sections: Section[] = Array.from(compMap.entries())
  .map(([comp, e]) => {
  const columns = unionColumns(e.columnsArrays);

  // 関連行はグレー表示＆後ろ寄せ（任意の整列規則）
  const rows = e.rows.sort((a: any, b: any) => {
    const ay = a.year == null ? -1 : a.year;
    const by = b.year == null ? -1 : b.year;
    if (by !== ay) return by - ay;
    const ar = a._is_related ? 1 : 0;
    const br = b._is_related ? 1 : 0;
    return ar - br;
  });

  const visibleColumns = columns.filter((c) => columnIsVisible(c, rows));
  const showAlias =
    rows.some((r: any) => typeof r.alias_label === "string" && r.alias_label.trim() !== "") ||
    rows.some((r: any) => !!r._is_related);
  const hasRelated = rows.some((r: any) => !!r._is_related);
  const hasSelf = rows.some((r: any) => !r._is_related);
  const hasAliasSelf = rows.some(
    (r: any) =>
      !r._is_related &&
      typeof r.alias_label === "string" &&
      r.alias_label.trim() !== ""
  );

  return {
    comp,
    competition_name: e.competition_name,
    columns: visibleColumns,
    rows,
    showAlias,
    hasRelated,
    hasSelf,
    hasAliasSelf,
  } as any;
  })
  .sort((a: any, b: any) => {
    const ao = compOrder.get(a.comp);
    const bo = compOrder.get(b.comp);
    const ap = ao == null ? 9_999_999 : ao;
    const bp = bo == null ? 9_999_999 : bo;
    if (ap !== bp) return ap - bp;
    return String(a.comp).localeCompare(String(b.comp));
  });

// year 表示用（byYear を sources 分集約）
const dataYearSelf = getComedianTablesByYear(id)!;
const tablesYearBySource = sources
  .map((s) => ({
    ...s,
    data: s.id === id ? dataYearSelf : getComedianTablesByYear(s.id),
  }))
  .filter((x) => !!x.data) as Array<Source & { data: any }>;

const yearMap = new Map<
  string,
  { year: number | null; columnsArrays: ColumnMeta[][]; rows: any[] }
>();

for (const st of tablesYearBySource) {
  for (const blk of st.data.byYear ?? []) {
    const key = blk.year == null ? "unknown" : String(blk.year);
    const e =
      yearMap.get(key) ??
      {
        year: (blk.year ?? null) as number | null,
        columnsArrays: [] as ColumnMeta[][],
        rows: [] as any[],
      };

    e.columnsArrays.push((blk.columns ?? []) as ColumnMeta[]);
    for (const r of (blk.rows ?? []) as any[]) {
    const baseAlias =
      typeof r.alias_label === "string" ? r.alias_label.trim() : "";
    const relatedLabel = st.is_related ? st.label : "";
    e.rows.push({
      ...r,
      alias_label: st.is_related ? relatedLabel : baseAlias,
      _is_related: st.is_related,
    });
    }
    yearMap.set(key, e);
  }
}

const yearBlocks = Array.from(yearMap.values())
  .map((e) => {
    const columns = unionColumns(e.columnsArrays);
    const rows = e.rows.slice().sort((a: any, b: any) => {
      // 1) 決勝日ベースの時系列（降順）
      const ad = typeof a.final_sort === "number" ? a.final_sort : 0;
      const bd = typeof b.final_sort === "number" ? b.final_sort : 0;
      if (bd !== ad) return bd - ad;

      // 2) 同日の安定化（大会順→大会キー）
      const aso = a.comp_sort_order ?? 9_999_999;
      const bso = b.comp_sort_order ?? 9_999_999;
      if (aso !== bso) return aso - bso;
      const ck = String(a.comp ?? "").localeCompare(String(b.comp ?? ""));
      if (ck !== 0) return ck;

      // 3) 同一大会内：本人行→関連行（見た目の安定化）
      const ar = a._is_related ? 1 : 0;
      const br = b._is_related ? 1 : 0;
      if (ar !== br) return ar - br;

      // 4) 最後の安定化（ID）
      return String(a.link_id ?? "").localeCompare(String(b.link_id ?? ""));
    });
    const visibleColumns = columns.filter((c) => columnIsVisible(c, rows));
    const showAlias = rows.some(
      (r: any) => typeof r.alias_label === "string" && r.alias_label.trim() !== ""
    );
    const hasRelated = rows.some((r: any) => !!r._is_related);
    return { year: e.year, columns: visibleColumns, rows, showAlias, hasRelated };
  })
  .sort((a: any, b: any) => {
    const ay = a.year == null ? -1 : a.year;
    const by = b.year == null ? -1 : b.year;
    return by - ay;
  });

// タイトル用の表示名を作成
const titleName =
  typeof comedian.note === "string" && comedian.note.trim() !== ""
    ? `${comedian.name}（${comedian.note}）`
    : comedian.name;

// 日付表示用の関数
// 環境変数VITE_BUILD_DATEがあればそれを使い、なければ現在日時を使用
const buildDate = import.meta.env.VITE_BUILD_DATE;

// 日本時間での日付を作成
let TODAY: Date;
if (buildDate) {
  // YYYY-MM-DD形式から年、月、日を分解
  const [year, month, day] = buildDate.split('-').map(Number);
  // Dateコンストラクタを使用（月は0ベースなので-1）
  TODAY = new Date(year, month - 1, day);
} else {
  // 日本時間（JST = UTC+9）で現在の日付を取得
  const now = new Date();
  TODAY = new Date(now.getTime() + (9 * 60 * 60 * 1000));
}

function formatDateWithAge(dateStr: string | null): { dateText: string; ageText: string; actionText: string } | null {
  if (!dateStr) return null;
  
  const normalized = dateStr.replace(/年|月|日/g, '/').replace(/\/+/g, '/').replace(/\/$/, '');
  const parts = normalized.split('/').map(p => parseInt(p.trim()));
  
  if (parts.length === 0 || isNaN(parts[0])) return null;
  
  const year = parts[0];
  const month = parts.length >= 2 && !isNaN(parts[1]) ? parts[1] : 4; // デフォルト4月
  const day = parts.length >= 3 && !isNaN(parts[2]) ? parts[2] : 1;   // デフォルト1日
  
  // 日付文字列の作成
  let dateText = '';
  if (parts.length >= 3 && !isNaN(parts[2])) {
    dateText = `${year}年${month}月${day}日`;
  } else if (parts.length >= 2 && !isNaN(parts[1])) {
    dateText = `${year}年${month}月`;
  } else {
    dateText = `${year}年`;
  }
  
  // 年齢の計算（正確な計算）
  const birthDate = new Date(year, month - 1, day);
  let age = TODAY.getFullYear() - birthDate.getFullYear();
  
  // 今年の誕生日がまだ来ていない場合は1歳減らす
  const todayMonthDay = TODAY.getMonth() * 100 + TODAY.getDate();
  const birthMonthDay = birthDate.getMonth() * 100 + birthDate.getDate();
  if (todayMonthDay < birthMonthDay) {
    age--;
  }
  
  // 年齢表記
  const ageText = comedian.kind === 'person' ? `${age}歳` : `${age}年`;
  const actionText = comedian.kind === 'person' ? '生まれ' : '結成';
  
  return { dateText, ageText, actionText };
}

const birthDateData = formatDateWithAge(comedian.birth_date);

export interface Props {
  size?: number;          // px
  title?: string;
  class?: string;
}

type ResultColumnRole =
  | "default"
  | "firstOrder"
  | "withVideo"
  | "alias";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
};

// 共通: 列に role を付ける helper
function enrichColumns(
  rawCols: any[],
  opts?: { withAlias?: boolean }
): Column[] {
  const cols: Column[] = rawCols.map((c: any) => {
    let role: ResultColumnRole | undefined;

    if (c.key === "first_order") {
      role = "firstOrder";
    } else if (c.related_key) {
      role = "withVideo";
    }

    return { ...c, role };
  });

  if (opts?.withAlias) {
    cols.push({
      key: "alias_label",
      label: "名義",
      col_class: "col-alias",
      is_multiline: 1,
      role: "alias",
    });
  }

  return cols;
}

// sections / yearBlocks に _cols を持たせた拡張版を作る
const sectionsWithCols = sections.map((sec: any) => ({
  ...sec,
  _cols: enrichColumns(sec.columns, { withAlias: !!sec.showAlias }),
}));

const yearBlocksWithCols = yearBlocks.map((blk: any) => ({
  ...blk,
  _cols: enrichColumns(blk.columns, { withAlias: !!blk.showAlias }),
}));
---

<Base title={`${titleName} の記録`}>
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <a href={`${base}co`}>芸人一覧</a><span class="sep">/</span>
    <span>{comedian.name}</span>
  </nav>

  <h1>{comedian.name} の記録</h1>

  <!-- 読み仮名・備考・誕生日/結成日 -->
  {(comedian.reading || comedian.note || birthDateData) && (
    <p class="info-line muted">
      {comedian.reading && <span class="yomi">{comedian.reading}</span>}
      {comedian.reading && (comedian.note || birthDateData) && <span class="sep"> ／ </span>}
      {comedian.note && <span class="note">{comedian.note}</span>}
      {comedian.note && birthDateData && <span class="sep"> ／ </span>}
      {birthDateData && (
        <span class="birth-date">
          {birthDateData.dateText}{birthDateData.actionText}
          <span class="age-text">（{birthDateData.ageText}）</span>
        </span>
      )}
      {comedian.m1_url && (
        <>
          <span class="sep"> ／ </span>
          <a href={comedian.m1_url} target="_blank" rel="noopener" class="ext-link ext-link__a">
            <span>M-1</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" class="ext-ico">
              <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h7v2H7v10h10v-5h2v7H5V5z"/>
            </svg>
          </a>
        </>
      )}
    </p>
  )}

  <!-- 所属メンバー・ユニット -->
  {(members.length > 0 || units.length > 0) && (
    <p class="aff-line muted">
      {members.length > 0 && (
        <>
          <span class="aff-label">所属メンバー:</span>{" "}
          {members.map((m, i) => (
            <>
              {i > 0 && <span class="aff-sep">/</span>}
              <a class="aff-link" href={`${base}co/${m.link_id}`}>{m.name}</a>
            </>
          ))}
        </>
      )}
      {members.length > 0 && units.length > 0 && <span class="aff-divider">｜</span>}
      {units.length > 0 && (
        <>
          <span class="aff-label">所属ユニット:</span>{" "}
          {units.map((u, i) => (
            <>
              {i > 0 && <span class="aff-sep">/</span>}
              <a class="aff-link" href={`${base}co/${u.link_id}`}>{u.name}</a>
            </>
          ))}
        </>
      )}
    </p>
  )}

  <!-- 関連ユニット（ユニットページ時） -->
  {comedian.kind === 'unit' && relatedUnits.length > 0 && (
    <p class="aff-line muted">
      <span class="aff-label">関連ユニット:</span>{" "}
      {relatedUnits.map((u, i) => (
        <>
          {i > 0 && <span class="aff-sep">/</span>}
          <a class="aff-link" href={`${base}co/${u.link_id}`}>{u.name}</a>
        </>
      ))}
    </p>
  )}

  <!-- 関連メンバー（メンバーページ時） -->
  {comedian.kind === 'person' && relatedMembers.length > 0 && (
    <p class="aff-line muted">
      <span class="aff-label">関連メンバー:</span>{" "}
      {relatedMembers.map((m, i) => (
        <>
          {i > 0 && <span class="aff-sep">/</span>}
          <a class="aff-link" href={`${base}co/${m.link_id}`}>{m.name}</a>
        </>
      ))}
    </p>
  )}

  <!-- 表示モード切替 -->
  <div class="view-toggle" id="view-toggle" data-mode="comp">
    <div class="view-toggle__left">
      <div class="view-toggle__buttons">
        <button class="btn is-active" type="button" data-go="comp">大会ごと</button>
        <button class="btn" type="button" data-go="year">年ごと</button>
      </div>
      {hasAnyRelated && (
        <button
          id="toggle-related"
          class="rel-switch-row"
          type="button"
          role="switch"
          aria-checked="true"
        >
          <span class="rel-switch-label">
            {comedian.kind === "person" ? "所属ユニットの記録を表示" : "所属メンバーの記録を表示"}
          </span>
          <span class="rel-switch-track" aria-hidden="true">
            <span class="rel-switch-knob" aria-hidden="true"></span>
          </span>
        </button>
      )}
    </div>
  </div>

  <!-- 大会ごと表示 -->
  <div id="view-comp">
    {sectionsWithCols.map((sec) => (
      <section class="results-section" data-has-self={sec.hasSelf ? "1" : "0"}>
        <h2>{sec.competition_name}</h2>
        <div class="table-wrap">
          <table data-has-alias-self={sec.hasAliasSelf ? "1" : "0"}>
            <thead>
              <tr>
                <th class="sticky-1 col-year">回</th>
                <th class="sticky-2 col-rank">順位</th>
                {sec._cols.map((c: Column) => (
                  <th class={c.col_class ?? ""}>{c.label ?? c.key}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {sec.rows.map((r: any) => {
                const label = r.short_label ?? (r.year != null ? `${r.year}` : "—");
                const linkable = r.year != null;
                return (
                  <tr class={r._is_related ? "is-related" : ""}>
                    <td class="sticky-1 col-year">
                      {linkable ? (
                        <a href={`${base}${sec.comp}/${r.year}`}>{label}</a>
                      ) : (
                        <span class="muted">{label}</span>
                      )}
                    </td>
                    <td class="sticky-2 col-rank">
                      <span class="badge" data-ranksort={r.rank_sort}>{r.rank}</span>
                    </td>

                    <ResultDataCells base={base} cols={sec._cols} row={r} />
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <!-- 年ごと表示（新規） -->
  <div id="view-year" hidden>
    {yearBlocksWithCols.map((blk) => (
<section class="results-section">
        <h2>{blk.year != null ? `${blk.year}年` : "年不明"}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sticky-1 col-comp">大会</th>
                <th class="sticky-2 col-rank">順位</th>
                {blk._cols.map((c: Column) => (
                  <th class={c.col_class ?? ""}>{c.label ?? c.key}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {blk.rows.map((r: any) => (
                <tr class={r._is_related ? "is-related" : ""}>
                  <td class="sticky-1 col-comp">
                    <a href={`${base}${r.comp}/${r.year}`}>{r.competition_name}</a>
                  </td>
                  <td class="sticky-2 col-rank"><span class="badge" data-ranksort={r.rank_sort}>{r.rank}</span></td>

                  <ResultDataCells base={base} cols={blk._cols} row={r} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <style>
    .view-toggle {
      display:flex;
      align-items:center;
      justify-content: flex-start;
      gap:0.75rem;
      margin:1rem 0;
    }
    .view-toggle__left{
      display:flex;
      align-items:center;
      gap:0.75rem;
      flex-wrap: wrap; /* 画面が狭いときに自然に折り返す */
    }
    .view-toggle__buttons{
      display:flex;
      gap:0.5rem;
      flex: 0 0 auto;
    }

    /* スイッチ行はボタン群の近くで、過剰に横幅を取らない */
    .rel-switch-row{
      flex: 0 0 auto;
      max-width: 100%;
    }
    .rel-switch-label{
      white-space: nowrap;
    }
    .btn { border:1px solid var(--border, #ccc); padding:0.3rem 0.6rem; border-radius:6px; background:#fff; cursor: pointer; }
    .btn.is-active { background: var(--accent-weak, #eef6ff); }
    .ext-link { display:inline-flex; gap:0.25rem; align-items:center; }
    .ext-ico  { width:1em; height:1em; fill: currentColor; }

    /* 関連行はセル文字をグレー（バッジ列は除外） */
    :global(tr.is-related td:not(.col-rank)) {
      color: var(--muted);
    }
    
    /* 関連行の表示/非表示（JSが dataset を切り替える） */
    html[data-show-related="0"] tr.is-related { display: none; }

    /* 関連を非表示にしたとき、本人行が1つもないセクションは非表示 */
    html[data-show-related="0"] section.results-section[data-has-self="0"] {
      display: none;
    }

    /* 関連を非表示にしたとき、本人行に「名義」が一切ない表は「名義」列ごと隠す */
    html[data-show-related="0"] table[data-has-alias-self="0"] th.col-alias,
    html[data-show-related="0"] table[data-has-alias-self="0"] td.col-alias {
      display: none;
    }
    /* 関連を非表示にしたとき、本人行に「名義」が一切ない表は「名義」列ごと隠す */
    html[data-show-related="0"] :global(table[data-has-alias-self="0"] th.col-alias) {
      display: none;
    }
    html[data-show-related="0"] :global(table[data-has-alias-self="0"] td.col-alias) {
      display: none;
    }
    .rel-toggle { display:inline-flex; gap:0.4rem; align-items:center; user-select:none; }
    .rel-toggle input { transform: translateY(0.5px); }

    .rel-switch-wrap{
      display:flex;
      align-items:center;
      gap:0.6rem;
    }

    .rel-switch-label{
      color: var(--muted);
      font-size: 13px;
      user-select:none;
    }

    /* switch button */
.rel-switch-row{
  display:flex;
  align-items:center;
  gap:0.6rem;
  border:1px solid var(--border);
  background:#fff;
  border-radius:999px;
  padding:6px 10px;
  cursor:pointer;
}

.rel-switch-row:hover{
  background: color-mix(in srgb, var(--accent-weak) 55%, #fff);
}

.rel-switch-row:focus-visible{
  outline:2px solid color-mix(in srgb, var(--accent) 55%, #fff);
  outline-offset:2px;
}

.rel-switch-label{
  color: var(--muted);
  font-size: 13px;
  user-select:none;
  white-space: nowrap;
}

.rel-switch-track{
  position:relative;
  width:40px;
  height:22px;
  border-radius:999px;
  background: var(--accent-weak);
  border:1px solid var(--border);
  transition: background 120ms ease, border-color 120ms ease;
  flex: 0 0 auto;
}

.rel-switch-knob{
  position:absolute;
  top:2px;
  left:2px;
  width:18px;
  height:18px;
  border-radius:50%;
  background:#fff;
  border:1px solid var(--border);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  transition: transform 140ms ease, border-color 120ms ease;
}

.rel-switch-row[aria-checked="true"] .rel-switch-track{
  background: var(--accent-strong);
  border-color: color-mix(in srgb, var(--accent-strong) 70%, var(--border));
}
.rel-switch-row[aria-checked="true"] .rel-switch-knob{
  transform: translateX(18px);
  border-color: color-mix(in srgb, var(--accent-strong) 40%, var(--border));
}

/* 年齢表記を小さく */
.age-text {
  font-size: 0.85rem;
  color: var(--muted);
}

  </style>

  <script is:inline>
    const STORAGE_KEY = 'co.viewMode'; // 'comp' | 'year'
    const STORAGE_KEY_RELATED = 'co.showRelated'; // '1' | '0'

    const wrap  = document.getElementById('view-toggle');
    const btns  = Array.from(wrap?.querySelectorAll('button[data-go]') ?? []);
    const vComp = document.getElementById('view-comp');
    const vYear = document.getElementById('view-year');
    const relSwitch = document.getElementById('toggle-related');

    function setShowRelated(show, { persist = true, updateUrl = true } = {}) {
      document.documentElement.dataset.showRelated = show ? '1' : '0';

      if (relSwitch) {
        relSwitch.setAttribute('aria-checked', show ? 'true' : 'false');
      }

      if (persist) localStorage.setItem(STORAGE_KEY_RELATED, show ? '1' : '0');
      if (updateUrl) {
        const u = new URL(location.href);
        u.searchParams.set('rel', show ? '1' : '0');
        history.replaceState(null, '', u);
      }
      refreshEmptySections();
    }

    function readSwitchState() {
      if (!relSwitch) return true;
      return relSwitch.getAttribute('aria-checked') === 'true';
    }

    function toggleRelated() {
      setShowRelated(!readSwitchState());
    }

    if (relSwitch) {
      relSwitch.addEventListener('click', toggleRelated);
      relSwitch.addEventListener('keydown', (e) => {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          toggleRelated();
        }
      });
    }

    function setMode(mode, { persist = true, updateUrl = true } = {}) {
      if (!wrap || !vComp || !vYear) return;
      wrap.setAttribute('data-mode', mode);
      btns.forEach(b => b.classList.toggle('is-active', b.dataset.go === mode));
      vComp.hidden = (mode !== 'comp');
      vYear.hidden = (mode !== 'year');
      if (persist) localStorage.setItem(STORAGE_KEY, mode);
      if (updateUrl) {
        const u = new URL(location.href);
        u.searchParams.set('view', mode);
        history.replaceState(null, '', u);
      }
      refreshEmptySections();
    }

    function readInitialMode() {
      const q = new URL(location.href).searchParams.get('view');
      if (q === 'year' || q === 'comp') return q;
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved === 'year' || saved === 'comp') return saved;
      return 'comp';
    }

    function readInitialRelated() {
      const q = new URL(location.href).searchParams.get('rel');
      if (q === '0') return false;
      if (q === '1') return true;
      const saved = localStorage.getItem(STORAGE_KEY_RELATED);
      if (saved === '0') return false;
      if (saved === '1') return true;
      return true;
    }

    function refreshEmptySections() {
      const mode = wrap?.getAttribute('data-mode') || 'comp';
      const root = (mode === 'year') ? vYear : vComp;
      if (!root) return;

      root.querySelectorAll('section.results-section').forEach((sec) => {
        sec.hidden = false;
        const trs = Array.from(sec.querySelectorAll('tbody tr'));
        const visibleCount = trs.filter((tr) => getComputedStyle(tr).display !== 'none').length;
        sec.hidden = (visibleCount === 0);
      });
    }

    btns.forEach(b => {
      b.addEventListener('click', () => {
        const next = (b.dataset.go === 'year') ? 'year' : 'comp';
        setMode(next);
      });
    });

    // 戻る/進むでURLのviewが変わったときも反映
    window.addEventListener('popstate', () => {
      const q = new URL(location.href).searchParams.get('view');
      if (q === 'year' || q === 'comp') setMode(q, { persist: false, updateUrl: false });
      const r = new URL(location.href).searchParams.get('rel');
      if (r === '0' || r === '1') setShowRelated(r === '1', { persist: false, updateUrl: false });
      refreshEmptySections();
    });

    // 初期表示（URL > localStorage > 既定）
    setMode(readInitialMode(), { persist: false, updateUrl: false });
    setShowRelated(readInitialRelated(), { persist: false, updateUrl: false });
    refreshEmptySections();
  </script>
