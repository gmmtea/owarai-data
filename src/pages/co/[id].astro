---
import Base from "../../layouts/Base.astro";
import type { CoListItem } from "../../lib/queries";
import {
  listComedianIdsWithProfile,
  getComedianTables,
  getComedianTablesByYear,
  getUnitMembers,
  getPersonUnits,
  getRelatedUnitsForUnit,
  getRelatedMembersForPerson
} from "../../lib/queries";
import ResultDataCells from "../../components/ResultDataCells.astro";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const ids = listComedianIdsWithProfile(); // string[]
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params as { id: string };
const data = getComedianTables(id);
if (!data) throw new Error("該当データなし");
const { comedian, byComp } = data;

const members: CoListItem[] = getUnitMembers(id);
const units:   CoListItem[] = getPersonUnits(id);

// kind に応じて関連を取得
const relatedUnits:   CoListItem[] = comedian.kind === 'unit'   ? getRelatedUnitsForUnit(id)     : [];
const relatedMembers: CoListItem[] = comedian.kind === 'person' ? getRelatedMembersForPerson(id) : [];

/** 大会ごとに「列メタのユニオン」「全年の行」を事前計算 */
type ColumnMeta = {
  key: string;
  label?: string | null;
  pref_order?: number | null;
  is_multiline?: 0 | 1 | null;
  col_class?: string | null;
  related_key?: string | null;
};
type Section = {
  comp: string;
  competition_name: string;
  columns: ColumnMeta[];
  rows: any[];
  showAlias: boolean;
};

function unionColumns(colsArrays: ColumnMeta[][]): ColumnMeta[] {
  const seen = new Set<string>();
  const out: ColumnMeta[] = [];
  for (const arr of colsArrays) {
    for (const c of arr) {
      if (seen.has(c.key)) continue;
      seen.add(c.key);
      out.push(c);
    }
  }
  // 並び：pref_order → key 安定化
  out.sort((a, b) => {
    const ap = a.pref_order ?? 9_999_999;
    const bp = b.pref_order ?? 9_999_999;
    return ap !== bp ? ap - bp : String(a.key).localeCompare(String(b.key));
  });
  return out;
}

// 文字列が非空かどうか
function isNonEmptyString(v: unknown) {
  return typeof v === "string" ? v.trim() !== "" : v != null;
}

// 列 c が rows の中で1行でも“表示有り”なら true
function columnIsVisible(c: ColumnMeta, rows: any[]) {
  for (const r of rows) {
    // first_order は数値があれば表示（A-2番 の A は first_group 次第だが、数値無ければ空）
    if (c.key === "first_order") {
      const v = r[c.key];
      if (v !== null && v !== undefined && String(v).trim() !== "") return true;
      continue;
    }

    // 連動動画列がある場合は、テキスト or URL のどちらかが埋まっていれば“有り”
    if (c.related_key) {
      const text = r[c.key];
      const url  = r[c.related_key];
      if (isNonEmptyString(text) || isNonEmptyString(url)) return true;
      continue;
    }

    // 通常列
    if (isNonEmptyString(r[c.key])) return true;
  }
  return false;
}

// セクション生成
const sections: Section[] = Object.entries(byComp).map(([comp, block]: any) => {
  const columnsAllYears = block.years.map((y: any) => y.columns);
  const columns = unionColumns(columnsAllYears);

  const rows = block.years
    .flatMap((y: any) => y.rows)
    .sort((a: any, b: any) => (a.year == null ? 1 : b.year == null ? -1 : b.year - a.year));

  // ここで“全行空”の列を落とす
  const visibleColumns = columns.filter((c) => columnIsVisible(c, rows));

  // 名義列（alias_label）も全行空なら非表示
  const showAlias = rows.some((r: any) => typeof r.alias_label === "string" && r.alias_label.trim() !== "");

  return {
    comp,
    competition_name: block.competition_name,
    columns: visibleColumns,
    rows,
    showAlias,
  } as any;
});

const dataYear = getComedianTablesByYear(id)!;
const yearBlocks = dataYear.byYear;

// タイトル用の表示名を作成
const titleName =
  typeof comedian.note === "string" && comedian.note.trim() !== ""
    ? `${comedian.name}（${comedian.note}）`
    : comedian.name;

export interface Props {
  size?: number;          // px
  title?: string;
  class?: string;
}
const size = Astro.props.size ?? 16;
const title = Astro.props.title ?? "M-1公式";
const klass = Astro.props.class ?? "";
// 色はCSS変数で上書き可能（サイトのトーンに合わせたい場合）

type ResultColumnRole =
  | "default"
  | "firstOrder"
  | "withVideo"
  | "alias";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
};

// 共通: 列に role を付ける helper
function enrichColumns(rawCols: any[], opts?: { withAlias?: boolean }): Column[] {
  const cols: Column[] = rawCols.map((c: any) => {
    let role: ResultColumnRole | undefined;

    if (c.key === "first_order") {
      role = "firstOrder";
    } else if (c.related_key) {
      role = "withVideo";
    }

    return { ...c, role };
  });

  if (opts?.withAlias) {
    cols.push({
      key: "alias_label",
      label: "名義",
      col_class: "col-alias",
      role: "alias",
    });
  }

  return cols;
}

// sections / yearBlocks に _cols を持たせた拡張版を作る
const sectionsWithCols = sections.map((sec: any) => ({
  ...sec,
  _cols: enrichColumns(sec.columns, { withAlias: !!sec.showAlias }),
}));

const yearBlocksWithCols = yearBlocks.map((blk: any) => ({
  ...blk,
  _cols: enrichColumns(blk.columns, { withAlias: !!blk.showAlias }),
}));
---

<Base title={`${titleName} の記録`}>
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <a href={`${base}co`}>芸人一覧</a><span class="sep">/</span>
    <span>{comedian.name}</span>
  </nav>

  <h1>{comedian.name} の記録</h1>

  <!-- 読み仮名・備考 -->
  {(comedian.reading || comedian.note) && (
    <p class="reading-line muted">
      {comedian.reading && <span class="yomi">{comedian.reading}</span>}
      {comedian.reading && comedian.note && <span class="sep"> ／ </span>}
      {comedian.note && <span class="note">{comedian.note}</span>}
      {comedian.m1_url && (
        <a href={comedian.m1_url} target="_blank" rel="noopener" class="ext-link ext-link__a">
          <span>M-1</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" class="ext-ico">
            <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h7v2H7v10h10v-5h2v7H5V5z"/>
          </svg>
        </a>
      )}
    </p>
  )}

  <!-- 所属メンバー・ユニット -->
  {(members.length > 0 || units.length > 0) && (
    <p class="aff-line muted">
      {members.length > 0 && (
        <>
          <span class="aff-label">所属メンバー:</span>{" "}
          {members.map((m, i) => (
            <>
              {i > 0 && <span class="aff-sep">/</span>}
              {m.has_profile === 1
                ? <a class="aff-link" href={`${base}co/${m.link_id}`}>{m.name}</a>
                : <span class="aff-link-disabled">{m.name}</span>}
            </>
          ))}
        </>
      )}
      {members.length > 0 && units.length > 0 && <span class="aff-divider">｜</span>}
      {units.length > 0 && (
        <>
          <span class="aff-label">所属ユニット:</span>{" "}
          {units.map((u, i) => (
            <>
              {i > 0 && <span class="aff-sep">/</span>}
              {u.has_profile === 1
                ? <a class="aff-link" href={`${base}co/${u.link_id}`}>{u.name}</a>
                : <span class="aff-link-disabled">{u.name}</span>}
            </>
          ))}
        </>
      )}
    </p>
  )}

  <!-- ★ 追加ブロック: 関連ユニット（ユニットページ時） -->
  {comedian.kind === 'unit' && relatedUnits.length > 0 && (
    <p class="aff-line muted">
      <span class="aff-label">関連ユニット:</span>{" "}
      {relatedUnits.map((u, i) => (
        <>
          {i > 0 && <span class="aff-sep">/</span>}
          {u.has_profile === 1
            ? <a class="aff-link" href={`${base}co/${u.link_id}`}>{u.name}</a>
            : <span class="aff-link-disabled">{u.name}</span>}
        </>
      ))}
    </p>
  )}

  <!-- ★ 追加ブロック: 関連メンバー（メンバーページ時） -->
  {comedian.kind === 'person' && relatedMembers.length > 0 && (
    <p class="aff-line muted">
      <span class="aff-label">関連メンバー:</span>{" "}
      {relatedMembers.map((m, i) => (
        <>
          {i > 0 && <span class="aff-sep">/</span>}
          {m.has_profile === 1
            ? <a class="aff-link" href={`${base}co/${m.link_id}`}>{m.name}</a>
            : <span class="aff-link-disabled">{m.name}</span>}
        </>
      ))}
    </p>
  )}

  <!-- 表示モード切替 -->
  <div class="view-toggle" id="view-toggle" data-mode="comp">
    <button type="button" data-go="comp" class="btn is-active">大会ごと</button>
    <button type="button" data-go="year" class="btn">年ごと</button>
  </div>

  <!-- 大会ごと表示 -->
  <div id="view-comp">
    {sectionsWithCols.map((sec) => (
      <section>
        <h2>{sec.competition_name}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sticky-1 col-year">回</th>
                <th class="sticky-2 col-rank">順位</th>
                {sec._cols.map((c: Column) => (
                  <th class={c.col_class ?? ""}>{c.label ?? c.key}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {sec.rows.map((r: any) => {
                const label = r.short_label ?? (r.year != null ? `${r.year}` : "—");
                const linkable = r.year != null;
                return (
                  <tr>
                    <td class="sticky-1 col-year">
                      {linkable ? (
                        <a href={`${base}${sec.comp}/${r.year}`}>{label}</a>
                      ) : (
                        <span class="muted">{label}</span>
                      )}
                    </td>
                    <td class="sticky-2 col-rank">
                      <span class="badge" data-ranksort={r.rank_sort}>{r.rank}</span>
                    </td>

                    <ResultDataCells base={base} cols={sec._cols} row={r} />
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <!-- 年ごと表示（新規） -->
  <div id="view-year" hidden>
    {yearBlocksWithCols.map((blk) => (
      <section>
        <h2>{blk.year != null ? `${blk.year}年` : "年不明"}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sticky-1 col-comp">大会</th>
                <th class="sticky-2 col-rank">順位</th>
                {blk._cols.map((c: Column) => (
                  <th class={c.col_class ?? ""}>{c.label ?? c.key}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {blk.rows.map((r: any) => (
                <tr>
                  <td class="sticky-1 col-comp">
                    <a href={`${base}${r.comp}/${r.year}`}>{r.competition_name}</a>
                  </td>
                  <td class="sticky-2 col-rank"><span class="badge" data-ranksort={r.rank_sort}>{r.rank}</span></td>

                  <ResultDataCells base={base} cols={blk._cols} row={r} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <style>
    .view-toggle { display:flex; gap:0.5rem; margin:1rem 0; }
    .btn { border:1px solid var(--border, #ccc); padding:0.3rem 0.6rem; border-radius:6px; background:#fff; cursor: pointer; }
    .btn.is-active { background: var(--accent-weak, #eef6ff); }
    .ext-link { display:inline-flex; gap:0.25rem; align-items:center; }
    .ext-ico  { width:1em; height:1em; fill: currentColor; }
  </style>

  <script is:inline>
    const STORAGE_KEY = 'co.viewMode'; // 'comp' | 'year'

    const wrap  = document.getElementById('view-toggle');
    const btns  = Array.from(wrap?.querySelectorAll('button[data-go]') ?? []);
    const vComp = document.getElementById('view-comp');
    const vYear = document.getElementById('view-year');

    function setMode(mode, { persist = true, updateUrl = true } = {}) {
      if (!wrap || !vComp || !vYear) return;
      wrap.setAttribute('data-mode', mode);
      btns.forEach(b => b.classList.toggle('is-active', b.dataset.go === mode));
      vComp.hidden = (mode !== 'comp');
      vYear.hidden = (mode !== 'year');
      if (persist) localStorage.setItem(STORAGE_KEY, mode);
      if (updateUrl) {
        const u = new URL(location.href);
        u.searchParams.set('view', mode);
        history.replaceState(null, '', u);
      }
    }

    function readInitialMode() {
      const q = new URL(location.href).searchParams.get('view');
      if (q === 'year' || q === 'comp') return q;
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved === 'year' || saved === 'comp') return saved;
      return 'comp';
    }

    btns.forEach(b => {
      b.addEventListener('click', () => {
        const next = (b.dataset.go === 'year') ? 'year' : 'comp';
        setMode(next);
      });
    });

    // 戻る/進むでURLのviewが変わったときも反映
    window.addEventListener('popstate', () => {
      const q = new URL(location.href).searchParams.get('view');
      if (q === 'year' || q === 'comp') setMode(q, { persist: false, updateUrl: false });
    });

    // 初期表示（URL > localStorage > 既定）
    setMode(readInitialMode(), { persist: false, updateUrl: false });
  </script>
</Base>
