---
import Base from "../../layouts/Base.astro";
import { listUpdates } from "../../lib/queries";

const base = import.meta.env.BASE_URL;
const updates = listUpdates();

// "YYYY-MM-DD" → "YYYY年MM月DD日(曜)"
function formatJpDateWithWeek(s?: string | null) {
  if (!s) return "";
  const m = String(s).trim().match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (!m) return String(s);
  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
  const dt = new Date(Date.UTC(y, mo - 1, d));
  const youbi = ["日","月","火","水","木","金","土"][dt.getUTCDay()];
  return `${y}年${mo}月${d}日(${youbi})`;
}
---

<Base title="更新履歴 | お笑い主要データまとめ">
  <nav class="breadcrumbs">
    <a href={base}>トップ</a><span class="sep">/</span>
    <span>更新履歴</span>
  </nav>

  <h1>更新履歴</h1>

  {updates.length === 0 ? (
    <p class="muted">更新履歴はまだありません。</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="col-date">日付</th>
            <th class="col-content">内容</th>
          </tr>
        </thead>
        <tbody>
          {updates.map((u) => (
            <tr>
              <td class="col-date">{formatJpDateWithWeek(u.date)}</td>
              <td class="col-content multiline">{u.content}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <style>
    .col-date { 
      min-width: 140px; 
      white-space: nowrap; 
      font-variant-numeric: tabular-nums; 
    }
    .col-content { 
      min-width: 200px; 
    }
  </style>
</Base>
