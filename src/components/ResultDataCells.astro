---
type SortType = "text" | "number";

type ResultColumnRole =
  | "default"
  | "firstOrder"
  | "withVideo"
  | "alias";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
  sortable?: boolean;
  sort_type?: SortType;
  sort_key?: string | null;
};

const { base, cols, row } = Astro.props as {
  base?: string;
  cols: Column[];
  row: Record<string, any>;
};

/**
 * role の決定
 * - 明示されていればそれを優先
 * - なければ key / related_key から推定（後方互換用）
 */
function resolveRole(col: Column): ResultColumnRole {
  if (col.role) return col.role;
  if (col.key === "first_order") return "firstOrder";
  if (col.related_key) return "withVideo";
  return "default";
}
---

{cols.map((c) => {
  const role = resolveRole(c);
  const raw = row[c.key];

  // ソート用の値（現時点では素直に raw ベース）
  const sortText = raw == null ? "" : String(raw);
  let numValue: number | null = null;
  if (raw != null && raw !== "") {
    const n = Number(raw);
    if (!Number.isNaN(n)) {
      numValue = n;
    }
  }

  const cls = [
    c.col_class ?? "",
    c.is_multiline === 1 ? "multiline" : "",
  ]
    .filter(Boolean)
    .join(" ");

  // 共通で付ける data-* を準備
  const baseAttrs: any = {
    "data-key": c.key,
    "data-value-text": sortText,
  };
  if (numValue !== null) {
    baseAttrs["data-value-num"] = String(numValue);
  }

  // 出順: 「A-2番」形式で表示（group が無ければ「2番」）
  if (role === "firstOrder") {
    const ord = raw;
    const grp = row["first_group"];
    const text =
      ord == null || String(ord).trim() === ""
        ? ""
        : `${grp ? grp + "-" : ""}${ord}番`;

    // 出順列については、ソート用テキストは「素の数値」に寄せる
    const attrs: any = {
      ...baseAttrs,
      "data-value-text": ord == null ? "" : String(ord),
    };

    return (
      <td class={cls} {...attrs}>
        {text}
      </td>
    );
  }

  // 動画リンク付き列
  if (role === "withVideo") {
    const text = sortText;
    const urlRaw = c.related_key ? row[c.related_key] : undefined;
    const url = urlRaw ? String(urlRaw) : "";
    const isYouTube =
      !!url &&
      /(?:^https?:\/\/)?(?:www\.)?(?:youtube\.com|youtu\.be)\//i.test(url);

    return (
      <td class={cls} {...baseAttrs}>
        {text}
        {url && " "}
        {url && (
          <a
            class={`video-link ${isYouTube ? "video-youtube" : ""}`}
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={isYouTube ? "YouTubeで見る" : "動画を見る"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M23.5 6.2a4 4 0 0 0-2.8-2.8C18.5 3 12 3 12 3S5.5 3 3.3 3.4A4 4 0 0 0 .5 6.2 41 41 0 0 0 0 12c0 2 .2 3.8.5 5.8a4 4 0 0 0 2.8 2.8C5.5 21 12 21 12 21s6.5 0 8.7-.4a4 4 0 0 0 2.8-2.8c.3-2 .5-3.8.5-5.8s-.2-3.8-.5-5.8ZM9.75 15.02V8.98L15.5 12l-5.75 3.02Z"
              />
            </svg>
          </a>
        )}
      </td>
    );
  }

  // default / alias は同じ表示
  const text = sortText;

  return (
    <td class={cls} {...baseAttrs}>
      {text}
    </td>
  );
})}
