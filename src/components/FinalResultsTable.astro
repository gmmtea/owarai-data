---
import ResultTableCore from "./ResultTableCore.astro";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
};

type Row = {
  link_id: string;
  name: string;
  rank: string | number;
  rank_sort: number;
  [key: string]: any;
};

const { base, cols, rows } = Astro.props as {
  base: string;
  cols: Column[];
  rows: Row[];
};
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="sticky-1 col-name">芸人</th>
        <th class="sticky-2 col-rank">順位</th>
        {cols.map((c) => (
          <th class={c.col_class ?? ""}>{c.label ?? c.key}</th>
        ))}
      </tr>
    </thead>

    <ResultTableCore base={base} cols={cols} rows={rows} />
  </table>
</div>
