---
import ResultTableCore from "./ResultTableCore.astro";

type SortType = "text" | "number";

type ResultColumnRole =
  | "default"
  | "firstOrder"
  | "withVideo"
  | "alias";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
  sortable?: boolean;
  sort_type?: SortType;
  sort_key?: string | null;
};

type Row = {
  link_id: string;
  name: string;
  rank: string | number;
  rank_sort: number;
  reading?: string | null;
  [key: string]: any;
};

const { base, cols, rows } = Astro.props as {
  base: string;
  cols: Column[];
  rows: Row[];
};

// 「数値扱いしたい key」の暫定マップ
const NUMERIC_KEYS = new Set<string>([
  "year",
  "rank",
  "rank_sort",
  "first_order",
  "final_appearances",
  "final_consecutive",
  "final_gap_years",
  "total",
  "score",
  "first_score",
  "second_score",
  "third_score",
]);

function isSortableColumn(c: Column): boolean {
  // 明示的に false が指定されていたらソート不可
  if (c.sortable === false) return false;

  // 名義・キャッチコピーは仕様上ソート対象外
  if (c.role === "alias") return false;
  if (c.key === "catchphrase") return false;
  if (c.key === "alias_label") return false;
  if (c.key === "first_title") return false;
  if (c.key === "second_title") return false;
  if (c.key === "third_title") return false;

  // それ以外はソート可能
  return true;
}

function getSortType(c: Column): SortType {
  if (c.sort_type) return c.sort_type;
  if (NUMERIC_KEYS.has(c.key)) return "number";
  return "text";
}
---

<div class="table-wrap">
  <table class="result-table" data-sort-table="results">
    <thead>
      <tr>
        {/* 芸人名列: 読み（あれば）でソートするテキスト列 */}
        <th
          class="sticky-1 col-name"
          data-sortable="text"
          data-key="name"
          data-sort-state="none"
        >
          <span class="th-inner">
            <span class="th-label">芸人</span>
            <span class="th-sort-icons" aria-hidden="true">
              <span class="th-sort-icon th-sort-icon-up">▲</span>
              <span class="th-sort-icon th-sort-icon-down">▼</span>
            </span>
          </span>
        </th>

        {/* 順位列: rank_sort を使う数値列 */}
        <th
          class="sticky-2 col-rank"
          data-sortable="number"
          data-key="rank"
          data-sort-state="none"
        >
          <span class="th-inner">
            <span class="th-label">順位</span>
            <span class="th-sort-icons" aria-hidden="true">
              <span class="th-sort-icon th-sort-icon-up">▲</span>
              <span class="th-sort-icon th-sort-icon-down">▼</span>
            </span>
          </span>
        </th>

        {/* 残りの列 */}
        {cols.map((c) => {
          const sortable = isSortableColumn(c);
          const sortType = sortable ? getSortType(c) : null;
          const label = c.label ?? c.key;

          if (!sortable) {
            // ソート不可: ラベルのみ（アイコンなし）
            return (
              <th class={c.col_class ?? ""} data-key={c.key}>
                {label}
              </th>
            );
          }

          return (
            <th
              class={c.col_class ?? ""}
              data-key={c.key}
              data-sortable={sortType ?? undefined}
              data-sort-state="none"
            >
              <span class="th-inner">
                <span class="th-label">{label}</span>
                <span class="th-sort-icons" aria-hidden="true">
                  <span class="th-sort-icon th-sort-icon-up">▲</span>
                  <span class="th-sort-icon th-sort-icon-down">▼</span>
                </span>
              </span>
            </th>
          );
        })}
      </tr>
    </thead>

    <ResultTableCore base={base} cols={cols} rows={rows} />
  </table>
</div>

<script is:inline>
  (() => {
    const tables = document.querySelectorAll('table[data-sort-table="results"]');

    tables.forEach((table) => {
      const thead = table.tHead;
      const tbody = table.tBodies && table.tBodies[0];
      if (!thead || !tbody) return;

      // すべての th と、sortable な th を分けて持つ
      const allHeaders = Array.from(thead.querySelectorAll("th"));
      const sortableHeaders = allHeaders.filter((th) =>
        th.hasAttribute("data-sortable")
      );
      if (!sortableHeaders.length) return;

      let activeColIndex = -1; // 「全列中での」アクティブ列インデックス
      let direction = 1;       // 1: 昇順, -1: 降順

      function getSortType(th) {
        const t = th.getAttribute("data-sortable");
        return t === "number" || t === "text" ? t : null;
      }

      function clearAriaSort() {
        sortableHeaders.forEach((h) => h.removeAttribute("aria-sort"));
      }

      function applyVisualState() {
        sortableHeaders.forEach((th) => {
          const colIndex = allHeaders.indexOf(th); // 全列中での位置
          const state =
            colIndex === activeColIndex
              ? direction === 1
                ? "asc"
                : "desc"
              : "none";
          th.setAttribute("data-sort-state", state);
        });
      }

      function compareRows(a, b, colIndex, sortType) {
        const ac = a.children[colIndex];
        const bc = b.children[colIndex];
        if (!ac || !bc) return 0;

        if (sortType === "number") {
          const av = Number(ac.getAttribute("data-value-num") || "");
          const bv = Number(bc.getAttribute("data-value-num") || "");
          const aEmpty = Number.isNaN(av);
          const bEmpty = Number.isNaN(bv);
          if (aEmpty && bEmpty) return 0;
          if (aEmpty) return 1;  // 空は後ろ
          if (bEmpty) return -1;
          return av - bv;        // 基本は昇順（降順はあとで反転）
        }

        const at = (
          ac.getAttribute("data-value-text") ||
          ac.textContent ||
          ""
        ).trim();
        const bt = (
          bc.getAttribute("data-value-text") ||
          bc.textContent ||
          ""
        ).trim();

        if (!at && !bt) return 0;
        if (!at) return 1;
        if (!bt) return -1;

        return at.localeCompare(bt, "ja", {
          numeric: true,
          sensitivity: "base",
        });
      }

      sortableHeaders.forEach((th) => {
        const sortType = getSortType(th);
        if (!sortType) return;

        th.style.cursor = "pointer";

        th.addEventListener("click", () => {
          const colIndex = allHeaders.indexOf(th);
          if (colIndex === -1) return;

          if (activeColIndex === colIndex) {
            // 同じ列を再クリック → 昇順⇔降順トグル
            direction = -direction;
          } else {
            // 別の列をクリック → その列をアクティブにし、初期方向を列種別で決定
            activeColIndex = colIndex;
            // 出順・順位は昇順スタート、スコア・結果関連は降順スタート
            const key = th.getAttribute("data-key") || "";
            if (key === "first_order" || key === "rank") {
              direction = 1;  // 昇順（出順・順位）
            } else if (key === "total" || key === "score" || 
                       key === "first_score" || key === "second_score" || key === "third_score" ||
                       key === "first_result" || key === "second_result" || key === "third_result" ||
                       key.includes("score") || key.includes("result")) {
              direction = -1; // 降順（スコア・結果関連）
            } else {
              direction = sortType === "number" ? -1 : 1;
            }
          }

          const rows = Array.from(tbody.rows);
          rows.sort((a, b) => compareRows(a, b, colIndex, sortType));
          if (direction === -1) {
            rows.reverse();
          }
          rows.forEach((r) => tbody.appendChild(r));

          clearAriaSort();
          th.setAttribute(
            "aria-sort",
            direction === 1 ? "ascending" : "descending"
          );
          applyVisualState();
        });
      });

      // 初期状態を反映（全列 data-sort-state="none"）
      applyVisualState();
    });
  })();
</script>

<style is:inline>
  /* 見た目は控えめな上下矢印を右側に縦並びで表示 */
  .result-table th {
    white-space: nowrap;
  }

  .result-table th .th-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .result-table th .th-label {
    display: inline-block;
  }

  .result-table th[data-sortable] .th-sort-icons {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    font-size: 0.6em;
    line-height: 1;
    opacity: 0.8; /* 非アクティブ時は控えめ */
  }

  .result-table th[data-sortable] .th-sort-icon {
    display: block;
    text-align: center;
    opacity: 0.25;
  }

  /* アクティブ列の視覚強調 */
  .result-table th[data-sortable][data-sort-state="asc"] .th-sort-icons,
  .result-table th[data-sortable][data-sort-state="desc"] .th-sort-icons {
    opacity: 0.9;
  }

  .result-table th[data-sortable][data-sort-state="asc"] .th-sort-icon-up,
  .result-table th[data-sortable][data-sort-state="desc"] .th-sort-icon-down {
    opacity: 1;
    font-weight: 700;
  }
</style>
