---
type ResultColumnRole =
  | "default"     // 通常の値
  | "firstOrder"  // 出順（A-2番など）
  | "withVideo";  // テキスト＋動画リンク

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
};

type Row = {
  link_id: string;
  name: string;
  rank: string | number;
  rank_sort: number;
  [key: string]: any;
};

const { base, cols, rows } = Astro.props as {
  base: string;
  cols: Column[];
  rows: Row[];
};

/**
 * 後方互換のため:
 * - role が明示されていればそれを使う
 * - 無ければ key / related_key から推定
 */
function resolveRole(col: Column): ResultColumnRole {
  if (col.role) return col.role;
  if (col.key === "first_order") return "firstOrder";
  if (col.related_key) return "withVideo";
  return "default";
}
---

<tbody>
  {rows.map((r) => (
    <tr>
      <td class="sticky-1 col-name">
        <a href={`${base}co/${r.link_id}`}>{r.name}</a>
      </td>
      <td class="sticky-2 col-rank">
        <span class="badge" data-ranksort={r.rank_sort}>{r.rank}</span>
      </td>

      {cols.map((c) => {
        const v = (r as any)[c.key];
        const cls = [
          c.col_class ?? "",
          c.is_multiline === 1 ? "multiline" : "",
        ]
          .filter(Boolean)
          .join(" ");

        const role = resolveRole(c);

        // 出順: 「A-2番」形式で表示（group が無ければ「2番」）
        if (role === "firstOrder") {
          const ord = v;
          const grp = (r as any)["first_group"];
          const text =
            ord == null || String(ord).trim() === ""
              ? ""
              : `${grp ? grp + "-" : ""}${ord}番`;
          return <td class={cls}>{text}</td>;
        }

        const text = v == null ? "" : String(v);

        // 動画リンク付き列
        if (role === "withVideo") {
          const urlRaw = (r as any)[c.related_key ?? ""];
          const url = urlRaw ? String(urlRaw) : "";
          const isYouTube =
            !!url &&
            /(?:^https?:\/\/)?(?:www\.)?(?:youtube\.com|youtu\.be)\//i.test(
              url,
            );
          return (
            <td class={cls}>
              {text}
              {url && " "}
              {url && (
                <a
                  class={`video-link ${isYouTube ? "video-youtube" : ""}`}
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={
                    isYouTube ? "YouTubeで見る" : "動画を見る"
                  }
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path
                      fill="currentColor"
                      d="M23.5 6.2a4 4 0 0 0-2.8-2.8C18.5 3 12 3 12 3S5.5 3 3.3 3.4A4 4 0 0 0 .5 6.2 41 41 0 0 0 0 12c0 2 .2 3.8.5 5.8a4 4 0 0 0 2.8 2.8C5.5 21 12 21 12 21s6.5 0 8.7-.4a4 4 0 0 0 2.8-2.8c.3-2 .5-3.8.5-5.8s-.2-3.8-.5-5.8ZM9.75 15.02V8.98L15.5 12l-5.75 3.02Z"
                    />
                  </svg>
                </a>
              )}
            </td>
          );
        }

        // 通常列
        return <td class={cls}>{text}</td>;
      })}
    </tr>
  ))}
</tbody>
