---
import ResultDataCells from "./ResultDataCells.astro";

type ResultColumnRole =
  | "default"
  | "firstOrder"
  | "withVideo"
  | "alias";

type Column = {
  key: string;
  label?: string | null;
  col_class?: string | null;
  is_multiline?: number | null;
  related_key?: string | null;
  role?: ResultColumnRole;
};

type Row = {
  link_id: string;
  name: string;
  rank: string | number;
  rank_sort: number;
  [key: string]: any;
};

const { base, cols, rows } = Astro.props as {
  base: string;
  cols: Column[];
  rows: Row[];
};
---

<tbody>
  {rows.map((r) => (
    <tr>
      <td class="sticky-1 col-name">
        <a href={`${base}co/${r.link_id}`}>{r.name}</a>
      </td>
      <td class="sticky-2 col-rank">
        <span class="badge" data-ranksort={r.rank_sort}>{r.rank}</span>
      </td>

      <ResultDataCells base={base} cols={cols} row={r} />
    </tr>
  ))}
</tbody>
